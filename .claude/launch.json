{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "salty-server-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SALTY_ALLOW_DEFAULT_SECRET=true",
        "SALTY_DB_URL=jdbc:h2:file:./salty-db/dev;MODE=PostgreSQL;TRACE_LEVEL_FILE=0",
        "SALTY_IMAGE_DIR=./salty-images-h2",
        "./gradlew", ":server:run", "--console=plain"
      ],
      "port": 8080
    }
  ]
}
