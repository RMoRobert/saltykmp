# Copy to `keystore.properties` (gitignored) and fill in. Used by composeApp/build.gradle.kts to sign
# the Android release build for Play upload.
#
# storeFile   absolute path to the .jks/.keystore holding your UPLOAD key
# keyAlias    alias of the key inside that keystore
#
# If this app is already on Play, the key must be the one Play expects — with Play App Signing that is
# your upload key, otherwise the original release key. A mismatched key is rejected at upload and cannot
# be changed without Google's key-reset process.
storeFile=/absolute/path/to/upload-key.jks
storePassword=
keyAlias=
keyPassword=
