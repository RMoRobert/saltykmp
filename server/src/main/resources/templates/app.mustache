<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{{pageTitle}}</title>
    <link rel="icon" href="/static/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/static/icon-192.png" sizes="192x192" type="image/png">
    <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">

    <!-- Web Awesome 3 (MIT). Note dist-cdn, not dist: the dist/ build has bare module specifiers a
         browser can't resolve, and every component silently fails to upgrade. Version pinned —
         a floating major would be a silent redesign. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/styles/webawesome.css">
    <!-- Light and dark both come from the OS via <meta name="color-scheme">; there is no theme
         control, as Web Awesome's three themes are near-identical for the components used here. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/styles/themes/default.css">
    <!-- Web Awesome's own utility layer. utilities/fouce.css is their flash-of-undefined-elements
         fix and prose.css is their long-form typography — both were things I had hand-rolled. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/styles/utilities.css">
    <link rel="stylesheet" href="/static/app/app.css">

    <!-- Web Awesome's themes switch on a `wa-dark` class; they do NOT follow prefers-color-scheme
         on their own, so a dark-mode browser rendered the whole app light until this ran. Inline
         and ahead of first paint, or a dark-mode user gets a white flash on every load. -->
    <script>
      (function () {
        var m = window.matchMedia("(prefers-color-scheme: dark)");
        var apply = function () { document.documentElement.classList.toggle("wa-dark", m.matches); };
        apply();
        m.addEventListener("change", apply);
      })();
    </script>

    <!-- Repoints <wa-icon> at Material Symbols, so the web UI and the Compose app draw the same
         icons. Ahead of the loader: registering a library re-renders icons that already resolved,
         so a late registration would only mean a visible flicker from Font Awesome to Material. -->
    <script type="module" src="/static/app/icons.js"></script>

    <script type="module"
            src="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/webawesome.loader.js"></script>

    <!-- Alpine plugins register before Alpine itself, hence the order. -->
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/sort@3.16.3/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/focus@3.16.3/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.16.3/dist/cdn.min.js"></script>
    <script src="/static/app/app.js"></script>
</head>
<body>

<!-- Config travels in data attributes, not as JS string literals. Mustache escapes for HTML, which
     is the correct escaper for an attribute value but the wrong one inside <script>: a backslash in
     a username passed through untouched and started a bogus \u escape, throwing a SyntaxError that
     left window.SALTY undefined, the CSRF token empty, and every write rejected with 403. -->
<div id="salty-config" hidden
     data-csrf="{{csrfToken}}"
     data-username="{{username}}"
     data-is-admin="{{#isAdmin}}true{{/isAdmin}}{{^isAdmin}}false{{/isAdmin}}"
     data-version="{{version}}"
     data-build-time="{{buildTime}}"
     data-min-password-length="{{minPasswordLength}}"></div>

<!-- No x-init: Alpine calls init() on the x-data object automatically. Declaring both runs it
     twice and races two loadList() calls.

     Structure comes from <wa-page>, which supplies the responsive navigation-to-drawer behaviour,
     the toggle wiring and a skip-to-content link. It deliberately renders no sectioning elements of
     its own, so the real <header>, <nav> and <main> landmarks below are ours to provide. -->
<wa-page id="app" x-data="saltyApp()" x-cloak mobile-breakpoint="768px"
         :data-pane="pane" :data-chef="chefMode"
         @keydown.escape.window="chefMode && !dialog && exitChefMode()">

  <!-- wa-split does the layout (brand at one end, account at the other); the stylesheet only
       supplies the inset, since wa-page's header part has no padding of its own. -->
  <header slot="header" class="appbar wa-split wa-align-items-center">
    <!-- No hamburger here on purpose. wa-page renders its own navigation toggle and owns the
         drawer; a second hand-rolled button is what produced two of them side by side, and every
         workaround after that (data-toggle-nav, a !important override) was papering over it. -->

    <span class="appbar__brand"><img class="appbar__logo" src="/static/icon-192.png" alt="" width="24" height="24"> <strong>Salty</strong></span>

    <!-- Two menus, split by what they act on. The gear is about this installation — the library,
         which UI you get, what build is running. The person is about your account. Putting
         "Manage library" behind a person icon was the thing that made the old single menu read as
         a grab bag. -->
    <div class="appbar__menus wa-cluster wa-gap-2xs">
      <wa-dropdown class="appbar__settings">
        <wa-button slot="trigger" appearance="plain" size="small" title="Settings">
          <wa-icon name="gear" label="Settings"></wa-icon>
        </wa-button>
        <wa-dropdown-item @click="openLibraryManager()">
          <wa-icon slot="icon" name="sliders"></wa-icon> Manage library…
        </wa-dropdown-item>
        <wa-divider></wa-divider>
        <wa-dropdown-item type="link" href="/classic">
          <wa-icon slot="icon" name="table-list"></wa-icon> Classic view
        </wa-dropdown-item>
        <wa-dropdown-item @click="openDialog('about')">
          <wa-icon slot="icon" name="circle-info"></wa-icon> About…
        </wa-dropdown-item>
      </wa-dropdown>

      <wa-dropdown class="appbar__account">
        <wa-button slot="trigger" appearance="plain" size="small" title="Account">
          <wa-icon name="circle-user" label="Account"></wa-icon>
        </wa-button>
        <wa-dropdown-item disabled>Signed in as <strong x-text="username"></strong></wa-dropdown-item>
        <wa-divider></wa-divider>
        <!-- One item, not three. Your password, the apps allowed to sync as you and how chef mode
             behaves on this screen are all "settings about me", and splitting them across a menu
             meant knowing which one held the thing you were looking for before you looked. -->
        <wa-dropdown-item data-testid="open-preferences" @click="openDialog('preferences')">
          <wa-icon slot="icon" name="user-gear"></wa-icon> Preferences…
        </wa-dropdown-item>
        <template x-if="isAdmin">
          <wa-dropdown-item @click="openDialog('users')">
            <wa-icon slot="icon" name="users"></wa-icon> Manage users…
          </wa-dropdown-item>
        </template>
        <wa-divider></wa-divider>
        <wa-dropdown-item type="link" href="/logout">
          <wa-icon slot="icon" name="right-from-bracket"></wa-icon> Log out
        </wa-dropdown-item>
      </wa-dropdown>
    </div>
  </header>

  <!-- ═══════════════ navigation · the library ═══════════════
       A wa-tree, not hand-rolled buttons: the sidebar really is a disclosure outline (sections
       expand and collapse), so role="tree" is accurate, and single-selection, keyboard navigation
       and the expand/collapse chevrons all come from the component. -->
  <nav slot="navigation" class="rail" aria-label="Library">
    <!-- selection="leaf": parents only expand and collapse, so the group rows can't be selected
         at all. All Recipes / Favorites / Want to Make have no children, so they stay selectable. -->
    <wa-tree selection="leaf" class="railtree" @wa-selection-change="onTreeSelect($event)">
      <wa-tree-item data-kind="all" :selected="filter.kind === 'all'">
        <wa-icon name="book-open"></wa-icon> All Recipes
      </wa-tree-item>

      <wa-tree-item data-kind="favorites" :selected="filter.kind === 'favorites'">
        <wa-icon name="heart" variant="regular"></wa-icon>
        Favorites
      </wa-tree-item>

      <wa-tree-item data-kind="wantToMake" :selected="filter.kind === 'wantToMake'">
        <wa-icon name="bookmark" variant="regular"></wa-icon>
        Want to Make
      </wa-tree-item>

      <template x-for="group in libraryGroups" :key="group.kind">
        <wa-tree-item :expanded="group.kind === 'category'" data-group
                      :disabled="!group.items.length">
          <span x-text="group.label" @mouseenter="titleIfClipped($el)"></span>

          <template x-for="item in group.items" :key="item.id">
            <wa-tree-item :data-kind="group.kind" :data-id="item.id"
                          :selected="filter.kind === group.kind && filter.id === item.id">
              <wa-icon :name="group.icon"></wa-icon>
              <span x-text="item.name || 'Untitled'" @mouseenter="titleIfClipped($el)"></span>
            </wa-tree-item>
          </template>
        </wa-tree-item>
      </template>

      <!-- A heading with one child, rather than the single leaf this used to be, so shopping lists
           read as their own section of the library the way Categories and Courses do. It stays
           `expanded`: the group exists to label the section, and a collapsed heading would put a
           click in front of the only thing under it.
           The lists themselves are deliberately NOT enumerated here -- the middle column is where
           they live, with their item counts; repeating them in the rail would be two places to
           read the same thing. -->
      <wa-tree-item data-group expanded>
        <span>Shopping Lists</span>

        <wa-tree-item data-kind="shopping" :selected="section === 'shopping'">
          <wa-icon name="cart-shopping"></wa-icon>
          <span>All Lists</span>
        </wa-tree-item>
      </wa-tree-item>
    </wa-tree>
  </nav>

  <!-- ═══════════════ main · recipe list + recipe ═══════════════ -->
  <!-- Exactly one <main>, and it carries the id wa-page's skip-to-content link points at. The
       three panes inside are <section>s: nesting <main> inside <main> is invalid and exposed two
       unlabelled landmarks at once. -->
  <main class="panes" id="main-content">
  <!-- The list/recipe divider is draggable. `primary="start"` is the important half: the list keeps
       the width it was given and the recipe takes the rest, so resizing the window doesn't
       proportionally squeeze a column whose contents are a fixed-size thumbnail and a name. The
       snap is today's default, so a drag can find its way home. Width persists per browser --
       restoreSplit sets the ATTRIBUTE rather than the property, which is the upgrade-safe half of
       that: the autoloader may not have defined the element yet when Alpine gets here. -->
  <wa-split-panel class="panes__split" primary="start" position-in-pixels="280"
                  snap="280px" snap-threshold="16"
                  x-init="restoreSplit($el)"
                  @wa-reposition.debounce.250ms="rememberSplit($event.target)">
  <section class="list" slot="start" aria-label="Recipes" x-show="section === 'recipes'">
    <header class="list__head wa-split wa-align-items-center">
      <wa-button class="only-compact" size="small" appearance="plain" @click="showLibrary()">
        <wa-icon slot="start" name="chevron-left"></wa-icon> Library
      </wa-button>
      <h2 class="list__title wa-text-truncate" x-text="filter.label"></h2>

      <!-- Sort. Field and direction are two choices rather than eight combined ones, which is how
           the CMP and Swift apps put it too; the checkmarks are what make the current order
           readable, and the trigger's title says it without the menu being opened at all. The
           direction items carry a hint in the details slot because "Ascending" on a date does not
           say oldest-first on its own. -->
      <wa-dropdown placement="bottom-end" data-testid="sort-menu"
                   @wa-select="applySort($event.detail.item, $el)">
        <wa-button slot="trigger" size="small" appearance="plain" :title="sortLabel">
          <wa-icon name="arrow-down-short-wide" label="Sort"></wa-icon>
        </wa-button>
        <template x-for="opt in recipeSortOptions" :key="opt.key">
          <wa-dropdown-item type="checkbox" :checked="sortBy === opt.key"
                            :data-sort-field="opt.key" x-text="opt.label"></wa-dropdown-item>
        </template>
        <wa-divider></wa-divider>
        <wa-dropdown-item type="checkbox" :checked="sortAsc" data-sort-dir="asc">
          Ascending <span slot="details" x-text="sortHint(true)"></span>
        </wa-dropdown-item>
        <wa-dropdown-item type="checkbox" :checked="!sortAsc" data-sort-dir="desc">
          Descending <span slot="details" x-text="sortHint(false)"></span>
        </wa-dropdown-item>
      </wa-dropdown>

      <!-- The same split button the shopping lists grew, for the same reason: the common case stays
           one click and the alternatives are one more. This is where a `.saltyRecipe` file import
           goes when it arrives -- another way of making a recipe, so another item in this menu. -->
      <wa-button-group label="New recipe">
        <wa-button size="small" appearance="filled" data-testid="new-recipe"
                   @click="createRecipe()" title="New recipe">
          <wa-icon name="plus" label="New recipe"></wa-icon>
        </wa-button>
        <wa-dropdown placement="bottom-end">
          <wa-button slot="trigger" size="small" appearance="filled" data-testid="new-recipe-more"
                     title="Other ways to add">
            <wa-icon name="caret-down" label="Other ways to add"></wa-icon>
          </wa-button>
          <wa-dropdown-item @click="createRecipe()">
            <wa-icon slot="icon" name="plus"></wa-icon> New recipe
          </wa-dropdown-item>
          <wa-dropdown-item data-testid="import-from-web" @click="openDialog('import')">
            <wa-icon slot="icon" name="link"></wa-icon> Import from web…
          </wa-dropdown-item>
        </wa-dropdown>
      </wa-button-group>
    </header>

    <!-- type="search" is forwarded to the real <input>, so a phone keyboard offers a Search action
         key and the field carries search semantics. It does NOT double up on the clear button the
         way a native search field usually would next to `with-clear`: Web Awesome already resets
         ::-webkit-search-cancel-button and ::-webkit-search-decoration to nothing. -->
    <div class="list__search">
      <wa-input type="search" size="small" placeholder="Search recipes" x-model="query" with-clear>
        <wa-icon slot="start" name="magnifying-glass"></wa-icon>
      </wa-input>
    </div>

    <div class="list__scroll">
      <wa-spinner x-show="listLoading" class="centered"></wa-spinner>
      <wa-callout variant="danger" size="small" x-show="loadError" class="m-2">
        <span x-text="loadError"></span>
      </wa-callout>

      <!-- A real <ul>, and role="list" on top of it: `list-style: none` drops list semantics in
           Safari/VoiceOver, and the semantics are the entire point of the element here. They are
           what turns 200 announcements of "button" into "5 of 47", and they cost nothing visually.
           The arrow keys are bound here, on the container, so one handler serves every row and
           keeps working as x-for adds and removes them. -->
      <ul class="list__rows wa-list-plain" role="list" @keydown="rowKeys($event)">
      <template x-for="r in visibleRecipes" :key="r.id">
        <li>
        <!-- wa-flank puts the thumbnail beside the text, wa-frame crops it to a square without
             distorting it, and wa-stack spaces the lines: all Web Awesome layout utilities, so the
             only thing left for the stylesheet is the flank width and the row's own hit area. -->
        <button type="button" class="rrow" :class="{ 'rrow--on': r.id === selectedId }"
                @click="open(r.id)" :aria-current="r.id === selectedId"
                :tabindex="r.id === recipeTabId ? 0 : -1">
          <!-- The flank sits on a span inside the button rather than on the button itself: flex
               layout on a <button> has a long history of engine quirks, and a plain element is what
               the utility expects. (The row's height comes from .rrow in the stylesheet, which
               undoes the form-control height Web Awesome gives every bare button.) -->
          <span class="rrow__inner wa-flank wa-gap-s">
          <span class="rrow__thumb wa-frame:square">
            <template x-if="thumbUrl(r)">
              <img :src="thumbUrl(r)" alt="" loading="lazy" decoding="async">
            </template>
            <template x-if="!thumbUrl(r)">
              <wa-icon name="book-open" class="rrow__noimage"></wa-icon>
            </template>
          </span>

          <span class="rrow__text wa-stack wa-gap-3xs">
            <span class="rrow__name wa-text-truncate" x-text="r.name || 'Untitled'"
                    @mouseenter="titleIfClipped($el)"></span>
            <template x-if="rowSubtitle(r)">
              <span class="rrow__sub wa-caption-xs wa-text-truncate" x-text="rowSubtitle(r)"
                      @mouseenter="titleIfClipped($el)"></span>
            </template>
            <span class="rrow__marks wa-cluster wa-gap-2xs"
                  x-show="r.rating || r.isFavorite">
              <!-- readonly: the row is a link to the recipe, not a place to re-rate it. -->
              <wa-rating x-show="r.rating" readonly size="small" :value="r.rating || 0"
                         :label="(r.rating || 0) + ' out of 5'"></wa-rating>
              <wa-icon x-show="r.isFavorite" class="rrow__fav" name="heart" variant="solid"
                       label="Favorite"></wa-icon>
            </span>
          </span>
          </span>
        </button>
        </li>
      </template>
      </ul>

      <p class="empty" x-show="!listLoading && !visibleRecipes.length"
         x-text="query ? 'No matches' : 'Nothing here yet'"></p>
    </div>
  </section>

  <!-- The same middle column, showing shopping lists. Mirrors the Swift client, where the content
       column lists the shopping lists and the detail column shows the one that's selected. -->
  <section class="list" slot="start" aria-label="Shopping lists" x-show="section === 'shopping'">
    <header class="list__head wa-split wa-align-items-center">
      <wa-button class="only-compact" size="small" appearance="plain" @click="showLibrary()">
        <wa-icon slot="start" name="chevron-left"></wa-icon> Library
      </wa-button>
      <h2 class="list__title wa-text-truncate">Shopping Lists</h2>

      <!-- A split button, not a plain dropdown: a checklist is overwhelmingly the common case and
           stays one click, while the other shape costs one more. A dropdown would have made the
           default action two clicks to spare the rarer one, and a second top-level button would put
           two competing "+"s in a header this narrow.

           If recipes grow secondary create-actions later (duplicate, import from a URL), the "+" in
           the recipe list is the same problem and should become this same control -- which is the
           reason the menu repeats "Checklist" rather than listing only the alternative: the menu
           has to read as the full set of things this button makes. -->
      <wa-button-group label="New list">
        <wa-button size="small" appearance="filled" data-testid="new-list"
                   @click="createList()" title="New checklist">
          <wa-icon name="plus" label="New checklist"></wa-icon>
        </wa-button>
        <wa-dropdown placement="bottom-end">
          <wa-button slot="trigger" size="small" appearance="filled" title="Other list types">
            <wa-icon name="caret-down" label="Other list types"></wa-icon>
          </wa-button>
          <wa-dropdown-item @click="createList()">
            <wa-icon slot="icon" name="list-check"></wa-icon> Checklist
          </wa-dropdown-item>
          <wa-dropdown-item data-testid="new-markdown-list"
                            @click="createList({ freeform: true })">
            <wa-icon slot="icon" name="file-lines"></wa-icon> Markdown list
          </wa-dropdown-item>
        </wa-dropdown>
      </wa-button-group>
    </header>

    <div class="list__scroll">
      <wa-spinner x-show="shoppingListsLoading" class="centered"></wa-spinner>
      <!-- The same list semantics and the same one-tab-stop keyboard model as the recipe column;
           these are the same rows. -->
      <ul class="list__rows wa-list-plain" role="list" @keydown="rowKeys($event)">
      <template x-for="l in shoppingLists" :key="l.id">
        <li>
        <button type="button" class="rrow" :class="{ 'rrow--on': l.id === selectedListId }"
                @click="openList(l.id)" :aria-current="l.id === selectedListId"
                :tabindex="l.id === shoppingTabId ? 0 : -1">
          <span class="rrow__name wa-text-truncate" x-text="l.name || 'Untitled'"
                @mouseenter="titleIfClipped($el)"></span>
          <span class="rrow__meta wa-caption-xs wa-text-truncate" x-text="listMeta(l)"></span>
        </button>
        </li>
      </template>
      </ul>
      <p class="empty" x-show="!shoppingListsLoading && !shoppingLists.length">No lists yet</p>
    </div>
  </section>

  <!-- ═══════════════════ pane 3 · recipe ═══════════════════ -->
  <section class="detail" slot="end" aria-label="Recipe" x-show="section === 'recipes'">
    <!-- Only when there is something in it. Everything inside is conditional on a selection, so
         with none the bar rendered as an empty strip with a bottom border floating over "Select a
         recipe" -- a header for nothing. The condition is the exact inverse of the empty state's
         own further down, so the two can't drift apart and both show at once. -->
    <header class="detail__bar wa-split wa-align-items-center" x-show="current || loadingRecipe">
      <wa-button class="only-compact" size="small" appearance="plain" @click="backToList()">
        <wa-icon slot="start" name="chevron-left"></wa-icon> Recipes
      </wa-button>

      <h1 class="detail__title wa-text-truncate" x-text="current ? (current.name || 'Untitled') : ''"></h1>

      <template x-if="current">
        <div class="detail__actions wa-cluster wa-gap-2xs">
          <!-- Read is the default; Edit is an action, matching the Swift and CMP apps. -->
          <template x-if="mode === 'read'">
            <wa-button data-testid="chef" size="small" appearance="plain"
                       title="Read this recipe with the app out of the way"
                       @click="enterChefMode()">
              <wa-icon slot="start" name="circle-play"></wa-icon> Chef mode
            </wa-button>
          </template>

          <template x-if="mode === 'read'">
            <wa-button data-testid="edit" size="small" appearance="outlined" @click="mode = 'edit'">
              <wa-icon slot="start" name="pen"></wa-icon> Edit
            </wa-button>
          </template>

          <wa-dropdown>
            <wa-button slot="trigger" size="small" appearance="plain" data-testid="recipe-more"
                       title="More actions">
              <wa-icon name="ellipsis-vertical" label="More actions"></wa-icon>
            </wa-button>
            <!-- Creating a recipe belongs to the "+" in the list column and nowhere else; having
                 it here too meant two controls for one action and neither being the obvious one.
                 What this menu is for is the opposite: things that should take a moment to reach.
                 Additive, reversible actions added later (duplicate, import from a URL) belong
                 beside that "+" instead -- see the shopping-list split button. -->
            <wa-dropdown-item variant="danger" data-testid="delete-recipe"
                              @click="confirmDelete = true">
              <wa-icon slot="icon" name="trash"></wa-icon> Delete recipe…
            </wa-dropdown-item>
          </wa-dropdown>
        </div>
      </template>
    </header>

    <!-- The only control chef mode leaves on screen; Escape is the other way out. x-show rather
         than a CSS rule of our own, so Alpine puts back whatever display value wa-button had
         instead of this stylesheet having to guess one. -->
    <wa-button class="chefexit" x-show="chefMode" size="medium" appearance="filled"
               title="Exit chef mode (Esc)" @click="exitChefMode()">
      <wa-icon slot="start" name="xmark"></wa-icon> Exit
    </wa-button>

    <div class="doc">
      <wa-spinner x-show="loadingRecipe" class="centered"></wa-spinner>

      <div class="empty-state" x-show="!current && !loadingRecipe">
        <wa-icon name="book-open" class="empty-state__icon"></wa-icon>
        <p>Select a recipe.</p>
      </div>

      <template x-if="current">
        <article class="doc__inner">

          <!-- ─────────── READ ─────────── -->
          <template x-if="mode === 'read'">
            <div class="read">
              <h2 class="read__title" x-text="current.name || 'Untitled'"></h2>

              <template x-if="imageUrl">
                <img class="read__image" :src="imageUrl" alt="" loading="lazy">
              </template>

              <!-- One binding, not four templates each carrying its own separator: see metaLine.
                   x-show so a recipe with none of these fields loses the line rather than the
                   space it would have taken. -->
              <p class="read__meta" x-show="metaLine" x-text="metaLine"></p>

              <template x-if="current.introduction">
                <p class="read__intro" x-text="current.introduction"></p>
              </template>

              <section class="read__sect" x-show="ingredients.length">
                <div class="read__secthead">
                  <h3>Ingredients</h3>
                  <div class="scaler">
                    <wa-button :size="chefMode ? 'medium' : 'small'" appearance="plain"
                               @click="bumpScale(-1)" title="Halve">
                      <wa-icon name="minus" label="Decrease scale"></wa-icon>
                    </wa-button>
                    <output x-text="scaleLabel"></output>
                    <wa-button :size="chefMode ? 'medium' : 'small'" appearance="plain"
                               @click="bumpScale(1)" title="Double">
                      <wa-icon name="plus" label="Increase scale"></wa-icon>
                    </wa-button>
                  </div>
                </div>
                <ul class="read__list">
                  <template x-for="row in ingredients" :key="row.id">
                    <li :class="{ 'is-heading': row.isHeading, 'is-main': row.isMain }">
                      <span x-show="row.isHeading" x-text="row.text"></span>
                      <span x-show="!row.isHeading" x-html="scaledHTML(row.text)"></span>
                    </li>
                  </template>
                </ul>
              </section>

              <section class="read__sect" x-show="directions.length">
                <h3>Directions</h3>
                <!-- A <ul> with explicit numbers, not an <ol>: section headings are list items
                     too, and an <ol> counts them, so every heading shifted the numbering. -->
                <ul class="read__steps">
                  <template x-for="(row, i) in directions" :key="row.id">
                    <li :class="{ 'is-heading': row.isHeading }">
                      <template x-if="!row.isHeading">
                        <span class="stepno" x-text="stepNumber(i) + '.'"></span>
                      </template>
                      <span x-text="row.text"></span>
                    </li>
                  </template>
                </ul>
              </section>

              <template x-if="(current.preparationTimes || []).length">
                <section class="read__sect">
                  <h3>Times</h3>
                  <dl class="read__pairs wa-grid">
                    <template x-for="t in current.preparationTimes" :key="t.id">
                      <div class="read__pair">
                        <dt x-text="t.type"></dt>
                        <dd x-text="t.timeString"></dd>
                      </div>
                    </template>
                  </dl>
                </section>
              </template>

              <template x-if="(current.notes || []).length">
                <section class="read__sect">
                  <h3>Notes</h3>
                  <template x-for="n in current.notes" :key="n.id">
                    <div class="read__block">
                      <h4 x-text="n.title"></h4>
                      <p class="read__body" x-text="n.content"></p>
                    </div>
                  </template>
                </section>
              </template>

              <template x-if="(current.variations || []).length">
                <section class="read__sect">
                  <h3>Variations</h3>
                  <template x-for="v in current.variations" :key="v.id">
                    <div class="read__block">
                      <h4 x-text="v.variationName"></h4>
                      <p class="read__body" x-text="v.text"></p>
                    </div>
                  </template>
                </section>
              </template>

              <template x-if="hasNutrition">
                <section class="read__sect">
                  <h3>Nutrition</h3>
                  <dl class="read__pairs wa-grid">
                    <template x-for="row in nutritionRows" :key="row.label">
                      <div class="read__pair">
                        <dt x-text="row.label"></dt>
                        <dd x-text="row.value"></dd>
                      </div>
                    </template>
                  </dl>
                </section>
              </template>

              <p class="read__footer">
                <template x-if="current.source">
                  <span>Source: <strong x-text="current.source"></strong>
                    <template x-if="current.sourceDetails">
                      <span> — <span x-text="current.sourceDetails"></span></span>
                    </template>
                  </span>
                </template>
                <template x-if="current.lastPrepared">
                  <span class="read__made">Last made <span x-text="relativeDate(current.lastPrepared)"></span></span>
                </template>
              </p>
            </div>
          </template>

        </article>
      </template>
    </div>
  </section>

  <!-- ═══════════════════ pane 3 · shopping list ═══════════════════
       Unlike a recipe this edits in place with no Edit button: a shopping list is worked, not
       composed, and autosaves as items are ticked (see touchList). That's also what makes
       concurrent edits ordinary here rather than rare, hence the merge on 409. -->
  <section class="detail" slot="end" aria-label="Shopping list" x-show="section === 'shopping'">
    <!-- Same empty-strip fix as the recipe bar above; inverse of this pane's own empty state. -->
    <header class="detail__bar wa-split wa-align-items-center" x-show="currentList">
      <wa-button class="only-compact" size="small" appearance="plain" @click="pane = 'list'">
        <wa-icon slot="start" name="chevron-left"></wa-icon> Lists
      </wa-button>

      <h1 class="detail__title wa-text-truncate" x-text="currentList ? (currentList.name || 'Untitled') : ''"></h1>

      <template x-if="currentList">
        <div class="detail__actions wa-cluster wa-gap-2xs">
          <span class="savebar__status" :class="{ 'is-dirty': listDirty }"
                x-text="listSaving ? 'Saving…' : (listDirty ? 'Unsaved changes' : 'All changes saved')"></span>
          <wa-dropdown>
            <wa-button slot="trigger" size="small" appearance="plain" title="More actions">
              <wa-icon name="ellipsis-vertical" label="More actions"></wa-icon>
            </wa-button>
            <wa-dropdown-item @click="addListHeading()">
              <wa-icon slot="icon" name="heading"></wa-icon> Add section heading
            </wa-dropdown-item>
            <wa-dropdown-item @click="clearCompleted()">
              <wa-icon slot="icon" name="broom"></wa-icon> Clear completed
            </wa-dropdown-item>
            <wa-divider></wa-divider>
            <wa-dropdown-item variant="danger" @click="confirmDeleteList = true">
              <wa-icon slot="icon" name="trash"></wa-icon> Delete list…
            </wa-dropdown-item>
          </wa-dropdown>
        </div>
      </template>
    </header>

    <div class="doc">
      <div class="empty-state" x-show="!currentList">
        <wa-icon name="cart-shopping" class="empty-state__icon"></wa-icon>
        <p>Select a list.</p>
      </div>

      <template x-if="currentList">
        <div class="doc__inner slist">
          <wa-input class="titlefield" x-model="currentList.name" @input="touchList()"
                    aria-label="List name" size="large"></wa-input>

          <!-- A freeform list is a scratch pad, so it gets a text area and nothing else. This is
               also the one shape that cannot be merged item by item, which is why the server may
               answer a conflict with a whole second copy. -->
          <template x-if="currentList.isFreeform">
            <!-- The note is the control's own `hint`, not a paragraph beside it: that is what wires
                 it up as the field's description for a screen reader, and it renders in Web
                 Awesome's hint style rather than one this app had to invent. -->
            <wa-textarea class="freeform" resize="auto" rows="12" aria-label="List contents"
                         with-hint x-model="currentList.contentsForFreeform" @input="touchList()"
                         hint="Plain-text Markdown. The phone and desktop apps render the formatting; this box deliberately shows you the source."></wa-textarea>
          </template>

          <template x-if="!currentList.isFreeform">
            <div>
              <!-- Enter is handled on the input rather than by form submission: wa-input keeps its
                   real <input> in shadow DOM, so a form never sees the implicit submit. -->
              <div class="slist__add wa-cluster wa-gap-xs">
                <wa-input size="small" placeholder="Add an item" x-model="newItemText"
                          aria-label="Add an item" @keydown.enter.prevent="addItem()">
                  <wa-icon slot="start" name="plus"></wa-icon>
                </wa-input>
                <wa-button size="small" appearance="filled" data-testid="add-item"
                           :disabled="!newItemText.trim()" @click="addItem()">Add</wa-button>
              </div>

              <p class="slist__count" x-show="currentList.contentsForList.length"
                 x-text="openItemCount + (openItemCount === 1 ? ' item left' : ' items left')"></p>

              <ul class="slist__rows wa-list-plain wa-stack wa-gap-3xs">
                <template x-for="item in sortedItems" :key="item.id">
                  <li class="sitem wa-cluster wa-gap-xs" :class="{ 'sitem--done': item.isCompleted && !item.isHeading,
                                              'sitem--heading': item.isHeading }">
                    <template x-if="!item.isHeading">
                      <wa-checkbox :checked="item.isCompleted"
                                   @change="item.isCompleted = $event.target.checked; touchList()"
                                   :aria-label="item.text"></wa-checkbox>
                    </template>

                    <wa-input class="sitem__text" size="small" appearance="filled"
                              x-model="item.text" @input="touchList()"
                              :aria-label="item.isHeading ? 'Section heading' : 'Item'"></wa-input>

                    <wa-button size="small" appearance="plain" x-show="!item.isHeading"
                               :title="item.isImportant ? 'Not important' : 'Mark important'"
                               @click="item.isImportant = !item.isImportant; touchList()">
                      <wa-icon name="star"
                               :variant="item.isImportant ? 'solid' : 'regular'"
                               :label="item.isImportant ? 'Important' : 'Mark important'"></wa-icon>
                    </wa-button>

                    <wa-button size="small" appearance="plain" title="Remove"
                               @click="removeItem(item)">
                      <wa-icon name="xmark" label="Remove"></wa-icon>
                    </wa-button>
                  </li>
                </template>
              </ul>

              <p class="empty" x-show="!currentList.contentsForList.length">
                Nothing on this list yet.
              </p>
            </div>
          </template>
        </div>
      </template>
    </div>
  </section>

  </wa-split-panel>
  </main>

  <!-- Nested inside nothing: a dialog opened from within the editor dialog would stack, so this
       is a sibling and the editor stays open behind it. -->
  <wa-dialog label="New tag" data-dialog="new-tag" :open="newTagOpen"
             @wa-hide="if ($event.target === $el) { newTagOpen = false; newTagName = ''; }">
    <wa-input label="Tag name" with-label x-model="newTagName" autofocus
              @keydown.enter.prevent="createTagInline()"></wa-input>
    <wa-button slot="footer" appearance="plain" @click="dismissNewTag()">Cancel</wa-button>
    <wa-button slot="footer" appearance="accent" variant="brand" data-testid="create-tag"
               :disabled="!newTagReady" @click="createTagInline()">Add</wa-button>
  </wa-dialog>

  <wa-dialog label="Delete list" :open="confirmDeleteList" @wa-hide="confirmDeleteList = false">
    <p>Delete <strong x-text="currentList ? (currentList.name || 'this list') : ''"></strong>? This
       cannot be undone.</p>
    <wa-button slot="footer" appearance="plain" @click="confirmDeleteList = false">Cancel</wa-button>
    <wa-button slot="footer" variant="danger" appearance="accent" @click="deleteList()">Delete</wa-button>
  </wa-dialog>

  <!-- Editing is modal, matching the Swift client, which presents its editor as a .sheet over the
       detail column rather than inside it. It also closes a real hazard: with the editor inline the
       rail and recipe list stayed live behind it, so picking another category swapped the middle
       column out from under the recipe being edited. Every other way out of an edit already had to
       remember to ask about unsaved work by hand; a dialog makes that structural instead.

       light-dismiss is left off (WA's default) so a stray click outside cannot discard an edit.
       Escape and the close button raise wa-hide, which is cancelable -- see onEditDialogHide. -->
  <wa-dialog class="editdlg" label="Edit recipe" :open="mode === 'edit'"
             @wa-hide="if ($event.target === $el) onEditDialogHide($event)">
    <!-- Built only while actually editing: a recipe merely being read shouldn't carry the whole
         editor -- every row, select and sortable -- around in the DOM behind a closed dialog. -->
    <template x-if="current && mode === 'edit'">
      <div class="edit">
        <!-- A plain outlined wa-input, not the borderless treatment the shopping-list title gets:
             styled down to look like a heading it read as static text, and nothing said the recipe
             name was the field you rename a recipe in. The label does that job. -->
        <wa-input class="titlefield" label="Name" with-label x-model="current.name"
                  @input="touch()" size="large"></wa-input>

        <wa-card class="sect">
          <div slot="header" class="sect__head wa-split wa-align-items-center"><h3>Image</h3></div>
          <!-- Staged, not uploaded on the spot: see chooseImage. The file input is the real one,
               kept off-screen rather than display:none so it stays focusable, with the wa-button
               acting as its label. -->
          <div class="imgedit wa-stack wa-gap-s">
            <template x-if="imageUrl">
              <img class="imgedit__preview" :src="imageUrl" alt="Recipe image">
            </template>
            <template x-if="!imageUrl">
              <div class="imgedit__empty">
                <wa-icon name="image" class="imgedit__icon"></wa-icon>
                <span>No image</span>
              </div>
            </template>

            <div class="imgedit__actions wa-cluster wa-gap-xs">
              <input type="file" id="imgfile" class="wa-visually-hidden" aria-label="Recipe image file"
                     accept="image/jpeg,image/png,image/gif" @change="chooseImage($event)">
              <wa-button size="small" appearance="filled" data-testid="choose-image"
                         @click="document.getElementById('imgfile').click()">
                <wa-icon slot="start" name="arrow-up-from-bracket"></wa-icon>
                <span x-text="imageUrl ? 'Replace…' : 'Choose Image…'"></span>
              </wa-button>
              <wa-button size="small" appearance="plain" data-testid="clear-image"
                         x-show="imageUrl" @click="clearImage()">
                <wa-icon slot="start" name="xmark"></wa-icon> Remove
              </wa-button>
              <span class="imgedit__hint" x-show="pendingImageFile || pendingImageRemoval"
                    x-text="pendingImageFile ? 'New image (will save with recipe)' : 'Will be removed on save'"></span>
            </div>
            <p class="imgedit__note">JPEG, PNG or GIF, up to 25 MB.</p>
          </div>
        </wa-card>

        <wa-card class="sect">
          <div slot="header" class="sect__head wa-split wa-align-items-center"><h3>Details</h3></div>

          <!-- Grouped into lines that belong together rather than one auto-fitting grid, which
               reflowed fields into arbitrary neighbours at every width. Each .fieldrow still wraps
               on a narrow screen, so this is grouping, not a fixed column count. -->
          <div class="fieldrow wa-grid">
            <wa-input label="Source" with-label x-model="current.source" @input="touch()"></wa-input>
            <wa-input label="Source details" with-label x-model="current.sourceDetails"
                      @input="touch()"></wa-input>
          </div>

          <wa-textarea class="intro" label="Introduction" with-label resize="auto" rows="3"
                       x-model="current.introduction" @input="touch()"></wa-textarea>

          <div class="fieldrow wa-grid">
            <wa-input label="Yield" with-label x-model="current.yield" @input="touch()"></wa-input>
            <!-- wa-number-input rather than wa-input type="number": Web Awesome resets the native
                 spin buttons away, so the plain input offered no stepper at all, and this is the
                 component it split them out into. Same standard `input` event, so x-model is
                 unchanged. -->
            <wa-number-input label="Servings" with-label step="1" min="0"
                             x-model.number="current.servings" @input="touch()"></wa-number-input>
            <wa-select label="Course" with-label x-model="current.courseId" @change="touch()">
              <wa-option value="">None</wa-option>
              <template x-for="c in courses" :key="c.id">
                <wa-option :value="c.id" x-text="c.name"></wa-option>
              </template>
            </wa-select>
          </div>

          <div class="fieldrow wa-grid">
            <wa-select label="Difficulty" with-label :value="String(current.difficulty ?? 0)"
                       @change="current.difficulty = Number($event.target.value); touch()">
              <wa-option value="0">(not set)</wa-option>
              <wa-option value="1">Easy</wa-option>
              <wa-option value="2">Somewhat Easy</wa-option>
              <wa-option value="3">Medium</wa-option>
              <wa-option value="4">Slightly Difficult</wa-option>
              <wa-option value="5">Difficult</wa-option>
            </wa-select>

            <!-- The only hand-written label in the editor: wa-rating's `label` is for screen
                 readers only, so .field__label reproduces Web Awesome's form-control label. -->
            <div class="field">
              <label class="field__label">Rating</label>
              <!-- width:max-content in CSS: wa-rating is role=slider and maps click position
                   across its element width, so a stretched box makes the last star unhittable. -->
              <wa-rating class="rating-field" label="Rating" :value="current.rating || 0"
                         @change="current.rating = Number($event.target.value); touch()"></wa-rating>
            </div>
          </div>

          <!-- Both flags were settable everywhere except the editor, which is the one place you'd
               expect to set them while writing the recipe down. -->
          <div class="fieldrow fieldrow--flags wa-cluster wa-gap-m">
            <wa-checkbox :checked="!!current.isFavorite"
                         @change="current.isFavorite = $event.target.checked; touch()">
              Favorite
            </wa-checkbox>
            <wa-checkbox :checked="!!current.wantToMake"
                         @change="current.wantToMake = $event.target.checked; touch()">
              Want to Make
            </wa-checkbox>
          </div>

          <div class="fieldrow wa-grid">
            <wa-select multiple with-clear max-options-visible="4" label="Categories" with-label
                       x-model="current.categoryIds" @change="touch()">
              <template x-for="c in categories" :key="c.id">
                <wa-option :value="c.id" x-text="c.name"></wa-option>
              </template>
            </wa-select>

            <!-- Cluster rather than a plain grid cell: the select carries its own label and the
                 button is aligned to the bottom of it, so both sit on the field's baseline. -->
            <div class="tagfield wa-cluster wa-gap-2xs">
              <wa-select multiple with-clear max-options-visible="4" label="Tags" with-label
                         x-model="current.tagIds" @change="touch()">
                <template x-for="t in tags" :key="t.id">
                  <wa-option :value="t.id" x-text="t.name"></wa-option>
                </template>
              </wa-select>
              <!-- Tags get invented while writing a recipe far more often than courses or
                   categories do, so this makes one and attaches it without leaving the editor. -->
              <wa-button size="small" appearance="plain" title="New tag"
                         data-testid="new-tag" @click="newTagOpen = true">
                <wa-icon name="plus" label="New tag"></wa-icon>
              </wa-button>
            </div>
          </div>

          <div class="fieldrow fieldrow--narrow wa-grid">
            <wa-input type="date" label="Last Prepared" with-label
                      :value="dateOnly(current.lastPrepared)"
                      @change="setLastPrepared($event.target.value)"></wa-input>
          </div>
        </wa-card>

        <wa-card class="sect">
          <div slot="header" class="sect__head wa-split wa-align-items-center">
            <h3>Ingredients</h3>
          </div>
          <ul class="rows rows--plain wa-list-plain" x-sort="(item, pos) => reorder('ingredients', item, pos)"
              x-sort:config="{ handle: '.grip' }">
            <template x-for="(row, i) in ingredients" :key="row.id">
              <li class="row" :class="{ 'row--heading': row.isHeading, 'row--main': row.isMain }"
                  x-sort:item="row.id">
                <span class="grip" title="Drag to reorder" aria-hidden="true">
                  <wa-icon name="grip-vertical"></wa-icon>
                </span>
                <wa-textarea class="row__edit" x-model="row.text" @input="touch()"
                             resize="auto" rows="1"
                             :aria-label="(row.isHeading ? 'Heading ' : 'Ingredient ') + (i + 1)"></wa-textarea>
                <span class="row__tools">
                  <wa-button size="small" appearance="plain" :disabled="i === 0"
                             :data-move="'ingredients:' + row.id + ':up'"
                             @click="moveRow('ingredients', row.id, -1)" title="Move up">
                    <wa-icon name="chevron-up" label="Move up"></wa-icon>
                  </wa-button>
                  <wa-button size="small" appearance="plain" :disabled="i === ingredients.length - 1"
                             :data-move="'ingredients:' + row.id + ':down'"
                             @click="moveRow('ingredients', row.id, 1)" title="Move down">
                    <wa-icon name="chevron-down" label="Move down"></wa-icon>
                  </wa-button>
                  <wa-button size="small" appearance="plain" x-show="!row.isHeading"
                             @click="row.isMain = !row.isMain; touch()"
                             :title="row.isMain ? 'Main ingredient' : 'Mark as main ingredient'">
                    <wa-icon name="star" :variant="row.isMain ? 'solid' : 'regular'"
                             label="Mark as main ingredient"></wa-icon>
                  </wa-button>
                  <wa-button size="small" appearance="plain" @click="removeRow('ingredients', i)" title="Delete">
                    <wa-icon name="xmark" label="Delete row"></wa-icon>
                  </wa-button>
                </span>
              </li>
            </template>
          </ul>
          <div slot="footer" class="sect__foot wa-cluster wa-gap-xs">
            <wa-button size="small" appearance="filled" @click="addRow('ingredients', false)">
              <wa-icon slot="start" name="plus"></wa-icon> Ingredient
            </wa-button>
            <wa-button size="small" appearance="plain" @click="addRow('ingredients', true)">
              <wa-icon slot="start" name="heading"></wa-icon> Section heading
            </wa-button>
          </div>
        </wa-card>

        <wa-card class="sect">
          <div slot="header" class="sect__head wa-split wa-align-items-center">
            <h3>Directions</h3>
          </div>
          <ul class="rows wa-list-plain" x-sort="(item, pos) => reorder('directions', item, pos)"
              x-sort:config="{ handle: '.grip' }">
            <template x-for="(row, i) in directions" :key="row.id">
              <li class="row" :class="{ 'row--heading': row.isHeading }" x-sort:item="row.id">
                <span class="grip" title="Drag to reorder" aria-hidden="true">
                  <wa-icon name="grip-vertical"></wa-icon>
                </span>
                <span class="row__lead" x-text="row.isHeading ? '' : stepNumber(i) + '.'"></span>
                <wa-textarea class="row__edit" x-model="row.text" @input="touch()"
                             resize="auto" rows="1"
                             :aria-label="(row.isHeading ? 'Heading ' : 'Step ') + (i + 1)"></wa-textarea>
                <span class="row__tools">
                  <wa-button size="small" appearance="plain" :disabled="i === 0"
                             :data-move="'directions:' + row.id + ':up'"
                             @click="moveRow('directions', row.id, -1)" title="Move up">
                    <wa-icon name="chevron-up" label="Move up"></wa-icon>
                  </wa-button>
                  <wa-button size="small" appearance="plain" :disabled="i === directions.length - 1"
                             :data-move="'directions:' + row.id + ':down'"
                             @click="moveRow('directions', row.id, 1)" title="Move down">
                    <wa-icon name="chevron-down" label="Move down"></wa-icon>
                  </wa-button>
                  <wa-button size="small" appearance="plain" @click="removeRow('directions', i)" title="Delete">
                    <wa-icon name="xmark" label="Delete row"></wa-icon>
                  </wa-button>
                </span>
              </li>
            </template>
          </ul>
          <div slot="footer" class="sect__foot wa-cluster wa-gap-xs">
            <wa-button size="small" appearance="filled" @click="addRow('directions', false)">
              <wa-icon slot="start" name="plus"></wa-icon> Step
            </wa-button>
            <wa-button size="small" appearance="plain" @click="addRow('directions', true)">
              <wa-icon slot="start" name="heading"></wa-icon> Section heading
            </wa-button>
          </div>
        </wa-card>

        <!-- Secondary editors. Collapsed by default and set apart from the cards above because most
             recipes have none of this, and seventeen nutrition fields left open would bury the
             ingredients. The summary carries a count, so what IS filled in is visible without
             opening anything. -->
        <wa-details class="subsect" data-testid="details-times"
                    :summary="'Preparation Times' + (current.preparationTimes.length ? ' (' + current.preparationTimes.length + ')' : '')">
          <template x-for="row in current.preparationTimes" :key="row.id">
            <div class="subrow wa-cluster wa-gap-xs">
              <wa-input size="small" placeholder='Type (e.g., "Bake")' aria-label="Time type"
                        x-model="row.type" @input="touch()"></wa-input>
              <wa-input size="small" placeholder='Time (e.g., "1 hr, 30 min")' aria-label="Time"
                        x-model="row.timeString" @input="touch()"></wa-input>
              <wa-button size="small" appearance="plain" title="Remove"
                         @click="removeSubRow('preparationTimes', row.id)">
                <wa-icon name="xmark" label="Remove"></wa-icon>
              </wa-button>
            </div>
          </template>
          <wa-button size="small" appearance="filled" data-testid="add-time"
                     @click="addSubRow('preparationTimes', { type: '', timeString: '' })">
            <wa-icon slot="start" name="plus"></wa-icon> Time
          </wa-button>
        </wa-details>

        <wa-details class="subsect" data-testid="details-notes"
                    :summary="'Notes' + (current.notes.length ? ' (' + current.notes.length + ')' : '')">
          <template x-for="row in current.notes" :key="row.id">
            <div class="subblock">
              <div class="subblock__head wa-cluster wa-gap-xs">
                <wa-input size="small" placeholder="Note Title" aria-label="Note title"
                          x-model="row.title" @input="touch()"></wa-input>
                <wa-button size="small" appearance="plain" title="Remove"
                           @click="removeSubRow('notes', row.id)">
                  <wa-icon name="xmark" label="Remove"></wa-icon>
                </wa-button>
              </div>
              <wa-textarea size="small" resize="auto" rows="2" placeholder="Note content"
                           aria-label="Note content" x-model="row.content" @input="touch()"></wa-textarea>
            </div>
          </template>
          <wa-button size="small" appearance="filled" data-testid="add-note"
                     @click="addSubRow('notes', { title: '', content: '' })">
            <wa-icon slot="start" name="plus"></wa-icon> Note
          </wa-button>
        </wa-details>

        <wa-details class="subsect" data-testid="details-variations"
                    :summary="'Variations' + (current.variations.length ? ' (' + current.variations.length + ')' : '')">
          <template x-for="row in current.variations" :key="row.id">
            <div class="subblock">
              <div class="subblock__head wa-cluster wa-gap-xs">
                <wa-input size="small" placeholder="Variation Name" aria-label="Variation name"
                          x-model="row.variationName" @input="touch()"></wa-input>
                <wa-button size="small" appearance="plain" title="Remove"
                           @click="removeSubRow('variations', row.id)">
                  <wa-icon name="xmark" label="Remove"></wa-icon>
                </wa-button>
              </div>
              <wa-textarea size="small" resize="auto" rows="2" placeholder="Text"
                           aria-label="Variation text" x-model="row.text" @input="touch()"></wa-textarea>
            </div>
          </template>
          <wa-button size="small" appearance="filled" data-testid="add-variation"
                     @click="addSubRow('variations', { variationName: '', text: '' })">
            <wa-icon slot="start" name="plus"></wa-icon> Variation
          </wa-button>
        </wa-details>

        <!-- Fields come from NUTRITION_GROUPS in app.js, which the reading view reads too, so
             the two can't drift and a new field only has to be named once. -->
        <wa-details class="subsect" data-testid="details-nutrition"
                    :summary="'Nutrition' + (nutritionRows.length ? ' (' + nutritionRows.length + ')' : '')">
          <template x-for="g in nutritionGroups" :key="g.group">
            <div class="nutgroup">
              <h4 class="nutgroup__head" x-text="g.group"></h4>
              <div class="nutgrid wa-grid">
                <template x-for="f in g.fields" :key="f.key">
                  <wa-input size="small" with-label
                            :label="f.label + (f.unit ? ' (' + f.unit + ')' : '')"
                            :type="f.text ? 'text' : 'number'"
                            :placeholder="f.placeholder || ''"
                            :value="nutritionValue(f.key)"
                            @input="setNutrition(f.key, $event.target.value, !!f.text)"></wa-input>
                </template>
              </div>
            </div>
          </template>
        </wa-details>

      </div>
    </template>

    <!-- Cancel and Save, the pairing people expect from a modal. It replaces Revert/Save/Done,
         which offered three exits for two intentions: Revert discarded AND closed (so it was
         Cancel by another name), while Save and Done differed only in whether the dialog stayed
         open -- a distinction nobody asked for. -->
    <div slot="footer" class="savebar savebar--dialog wa-cluster wa-gap-xs">
      <span class="savebar__status" :class="{ 'is-dirty': dirty }"
            x-text="dirty ? 'Unsaved changes' : 'All changes saved'"></span>
      <wa-button data-testid="cancel" size="small" appearance="plain"
                 @click="cancelEdit()">Cancel</wa-button>
      <wa-button data-testid="save" size="small" appearance="accent" variant="brand"
                 :loading="saving" @click="saveAndClose()">Save</wa-button>
    </div>
  </wa-dialog>

  <!-- Library manager: rename, add and remove courses, categories and tags. Deliberately plain --
       merging duplicates and reassigning recipes are deeper operations that belong with the
       existing LibraryDuplicateMerger work, not here. -->
  <wa-dialog label="Manage library" class="managedlg" data-dialog="library" :open="dialog === 'library'"
             @wa-hide="if ($event.target === $el) closeDialog('library')">
    <wa-tab-group>
      <template x-for="group in libraryGroups" :key="group.kind">
        <wa-tab :panel="group.kind" slot="nav" x-text="group.label"></wa-tab>
      </template>

      <template x-for="group in libraryGroups" :key="group.kind">
        <wa-tab-panel :name="group.kind">
          <div class="mgr">
            <template x-for="item in group.items" :key="item.id">
              <div class="mgr__row">
                <wa-input size="small" :value="item.name"
                          @change="renameClassifier(group.kind, item, $event.target.value)"
                          :aria-label="'Name of ' + (item.name || 'untitled')"></wa-input>
                <span class="mgr__count" x-text="recipeCountLabel(group.kind, item.id)"></span>
                <wa-button size="small" appearance="plain" variant="danger"
                           @click="askDeleteClassifier(group.kind, item)"
                           :title="'Delete ' + item.name">
                  <wa-icon name="trash" :label="'Delete ' + item.name"></wa-icon>
                </wa-button>
              </div>
            </template>

            <p class="mgr__empty" x-show="!group.items.length">Nothing here yet.</p>

            <form class="mgr__add" @submit.prevent="addClassifier(group.kind)">
              <wa-input size="small" :placeholder="'New ' + group.singular"
                        x-model="newClassifier[group.kind]"
                        :aria-label="'New ' + group.label"></wa-input>
              <wa-button size="small" appearance="filled" type="submit"
                         :disabled="!(newClassifier[group.kind] || '').trim()">Add</wa-button>
            </form>
          </div>
        </wa-tab-panel>
      </template>
    </wa-tab-group>

    <wa-button slot="footer" appearance="plain" @click="dismissDialog()">Done</wa-button>
  </wa-dialog>

  <wa-dialog label="Delete from library" :open="!!pendingClassifierDelete"
             @wa-hide="pendingClassifierDelete = null">
    <p x-show="pendingClassifierDelete">
      Delete “<strong x-text="pendingClassifierDelete?.item?.name"></strong>”?
      <template x-if="pendingClassifierDelete && countFor(pendingClassifierDelete.kind, pendingClassifierDelete.item.id) > 0">
        <span>It will be removed from
          <strong x-text="countFor(pendingClassifierDelete.kind, pendingClassifierDelete.item.id)"></strong>
          recipe(s). The recipes themselves are kept.</span>
      </template>
    </p>
    <wa-button slot="footer" appearance="plain" @click="pendingClassifierDelete = null">Cancel</wa-button>
    <wa-button slot="footer" variant="danger" appearance="accent"
               @click="deleteClassifier()">Delete</wa-button>
  </wa-dialog>

  <wa-dialog label="Delete recipe" :open="confirmDelete" @wa-hide="confirmDelete = false">
    <p>Delete “<strong x-text="current ? current.name : ''"></strong>”? This removes it from every
       synced device and can't be undone.</p>
    <wa-button slot="footer" appearance="plain" @click="confirmDelete = false">Cancel</wa-button>
    <wa-button slot="footer" variant="danger" appearance="accent" data-testid="confirm-delete"
               @click="doDelete()">Delete</wa-button>
  </wa-dialog>


  <!-- ═══════════════ account and settings dialogs ═══════════════
       These replace the Pico pages at /devices, /users and /about. They are dialogs rather than
       panes because none of them is a place you work — you come to change one thing and leave —
       and because that keeps the recipe list underneath exactly where you left it.

       Each is addressed by `dialog`, which mirrors the URL hash, so a reload or a back button
       lands where the user was rather than dumping them back on the recipe list. -->

  <!-- Import is a routed dialog like the rest, but unlike the rest it hands off: on success it
       closes itself and opens the editor on an UNSAVED draft. Nothing reaches the library until the
       user saves it, which is the same contract the desktop import has -- an imported page is
       untrusted content that happens to be shaped like a recipe. -->
  <wa-dialog label="Import from web" data-dialog="import" :open="dialog === 'import'"
             @wa-hide="if ($event.target === $el) closeDialog('import')">
    <form class="wa-stack wa-gap-m" @submit.prevent="runImport()">
      <p class="dlg__lead">Paste a recipe page's address. Salty reads the structured recipe data
        most recipe sites publish, then opens it for you to review before saving.</p>

      <wa-input label="Web address" with-label type="url" data-testid="import-url"
                placeholder="https://example.com/recipe" autocomplete="off"
                :disabled="importing" x-model="importUrl"
                @keydown.enter.prevent="runImport()"></wa-input>

      <wa-callout variant="danger" size="small" x-show="importError">
        <wa-icon slot="icon" name="circle-exclamation"></wa-icon>
        <span x-text="importError"></span>
      </wa-callout>
    </form>

    <wa-button slot="footer" appearance="plain" :disabled="importing"
               @click="dismissDialog()">Cancel</wa-button>
    <wa-button slot="footer" appearance="accent" variant="brand" data-testid="run-import"
               :loading="importing" :disabled="importing || !importUrl.trim()"
               @click="runImport()">Import</wa-button>
  </wa-dialog>

  <!-- Everything that is yours, in one place: how chef mode behaves on this screen, your
       password, and the apps allowed to sync as you. Administering OTHER people's accounts stays
       its own item on the menu — that is administration, not a preference.

       Sections, not tabs. Three short things read faster stacked than they do behind two clicks,
       and the password warning and the list of apps it is warning you about end up on the same
       screen, which is the arrangement that makes the warning mean something. -->
  <wa-dialog label="Preferences" class="acctdlg" data-dialog="preferences"
             :open="dialog === 'preferences'"
             @wa-hide="if ($event.target === $el) closeDialog('preferences')">

    <!-- Outside the tabs: it identifies the account both tabs act on, so it should not move or
         disappear when you switch between them. -->
    <p class="dlg__lead">Signed in as <strong x-text="username"></strong>.</p>

    <!-- Two tabs, split by what a setting DOES rather than by how many there are: General is how the
         app behaves for you, Security is what protects the account. The password form and the list of
         apps holding sync credentials belong together — changing the password signs every one of them
         out, and the list underneath is where you watch that happen. -->
    <!-- `active` is spelled out on both halves of the default tab rather than left to the tab group.
         wa-tab-group picks a first tab when its tabs arrive, and these arrive with the page, inside a
         dialog that is still closed -- so nothing is ever selected and BOTH panels stay display:none.
         The Manage library dialog gets away with omitting it because its tabs are built by x-for once
         the data loads, which is a mutation the group is watching for. -->
    <wa-tab-group class="prefdlg__tabs">
      <wa-tab panel="general" slot="nav" active>General</wa-tab>
      <wa-tab panel="security" slot="nav">Security</wa-tab>

      <wa-tab-panel name="general" active>
        <section class="prefsect">
          <h3 class="prefsect__head">Chef mode</h3>
          <!-- :checked, not x-model: x-model drives a control through its `value`, and a wa-switch
               carries its state on `checked`. Reading the change event back is also what lets the
               preference be applied and written in one place (setWakeLockPref). -->
          <!-- Shown off, not merely disabled, where the browser has no wake lock: a switch sitting in
               the "on" position while nothing is being kept awake is a lie the hint has to argue with.
               The stored preference is untouched, so it comes back on a browser that can honour it. -->
          <wa-switch data-testid="wakelock" :checked="wakeLockPref && wakeLockSupported"
                     :disabled="!wakeLockSupported"
                     @change="setWakeLockPref($event.target.checked)"
                     :hint="wakeLockSupported
                              ? 'Stops the screen dimming while you are reading a recipe in chef mode.'
                              : 'This browser cannot hold a screen wake lock. It needs a secure (https) connection to Salty.'">
            Keep the screen awake
          </wa-switch>
        </section>
      </wa-tab-panel>

      <wa-tab-panel name="security">
        <section class="prefsect">
          <h3 class="prefsect__head">Password</h3>
          <form class="wa-stack wa-gap-m" @submit.prevent="changePassword()">
            <!-- Stated before the fields, not after the fact: this is the surprising part, and someone
                 with three synced devices deserves to know before they commit, not from three
                 notifications afterwards. The list under it is the same three devices. -->
            <wa-callout variant="warning" size="small">
              <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
              Changing your password will sign out all sync clients and require username and password to re-enable sync.
            </wa-callout>

            <wa-input label="Current password" with-label type="password" password-toggle
                      autocomplete="current-password" x-model="pw.current"></wa-input>
            <wa-input label="New password" with-label type="password" password-toggle
                      autocomplete="new-password" x-model="pw.next"
                      :hint="`At least ${minPasswordLength} characters`"></wa-input>
            <wa-input label="Confirm new password" with-label type="password" password-toggle
                      autocomplete="new-password" x-model="pw.confirm"
                      @keydown.enter.prevent="changePassword()"></wa-input>

            <wa-callout variant="danger" size="small" x-show="pw.error">
              <wa-icon slot="icon" name="circle-exclamation"></wa-icon>
              <span x-text="pw.error"></span>
            </wa-callout>

            <!-- In the section, not the dialog footer, because the footer now belongs to the page
                 rather than to this one form. type="button" so the click handler is the only path;
                 the form's own submit is what Enter in the last field goes through. -->
            <wa-button class="prefsect__go" type="button" appearance="accent" variant="brand"
                       data-testid="save-password" :loading="pw.saving" :disabled="!passwordFormReady"
                       @click="changePassword()">Change password</wa-button>
          </form>
        </section>

        <wa-divider></wa-divider>

        <!-- "Authorized apps", not "Devices": what is listed is one app's enrolment, and the same phone
             running the phone app and a browser is not two devices to the person reading this. -->
        <section class="prefsect">
          <div class="prefsect__bar">
            <h3 class="prefsect__head">Authorized apps</h3>
            <wa-button size="small" appearance="outlined" variant="danger" x-show="hasLiveDevices"
                       @click="confirmRevokeAll = true">Sign all out</wa-button>
          </div>
          <p class="dlg__lead">Apps signed in to sync with this account. (Browser sessions are not listed here.)</p>

          <wa-spinner x-show="devices.loading" class="centered"></wa-spinner>
          <wa-callout variant="danger" size="small" x-show="devices.error">
            <span x-text="devices.error"></span>
          </wa-callout>
          <p class="empty" x-show="!devices.loading && !devices.rows.length">
            No apps signed in</p>

          <template x-for="d in devices.rows" :key="d.deviceId">
            <div class="acctrow" :class="{ 'acctrow--off': !d.hasToken }">
              <div class="acctrow__main">
                <wa-input size="small" :value="d.deviceName || ''" :placeholder="deviceFallbackName(d)"
                          @change="renameDevice(d, $event.target.value)"
                          :aria-label="'Name of ' + deviceLabel(d)"></wa-input>
                <span class="wa-caption-xs" x-text="deviceMeta(d)"></span>
              </div>
              <!-- A token-less row can only be one thing now -- signed out by a password change, waiting
                   to sign in again. Enrolment is mandatory at login, so "never enrolled" cannot happen,
                   and removal deletes the row, so "revoked" cannot linger. One state, one word. -->
              <wa-badge variant="neutral" x-show="!d.hasToken">Signed out</wa-badge>
              <wa-button size="small" appearance="plain" variant="danger"
                         @click="pendingDeviceRemove = d" :title="'Remove ' + deviceLabel(d)">
                <wa-icon name="trash" :label="'Remove ' + deviceLabel(d)"></wa-icon>
              </wa-button>
            </div>
          </template>
        </section>
      </wa-tab-panel>
    </wa-tab-group>

    <wa-button slot="footer" appearance="plain" @click="dismissDialog()">Done</wa-button>
  </wa-dialog>

  <!-- Says what removal actually costs. The row carries this app's sync watermark, so removing it
       makes the app's next sync a first sync: it re-downloads the library and re-uploads anything
       deleted here meanwhile. Worth knowing before you remove an app you still use. -->
  <wa-dialog label="Remove app" :open="!!pendingDeviceRemove" @wa-hide="pendingDeviceRemove = null">
    <p>Remove <strong x-text="pendingDeviceRemove ? deviceLabel(pendingDeviceRemove) : ''"></strong>?
      It stops syncing immediately. Signing in again with your password re-adds it, and it will
      re-download the whole library the first time it syncs.</p>
    <wa-button slot="footer" appearance="plain" @click="pendingDeviceRemove = null">Cancel</wa-button>
    <wa-button slot="footer" appearance="accent" variant="danger"
               @click="removeDevice(pendingDeviceRemove)">Remove</wa-button>
  </wa-dialog>

  <wa-dialog label="Sign every app out" :open="confirmRevokeAll" @wa-hide="confirmRevokeAll = false">
    <p>Sign every app out of this account? Each stops syncing until it signs in again with your
      password. Their sync history is kept, so nothing re-downloads.</p>
    <wa-button slot="footer" appearance="plain" @click="confirmRevokeAll = false">Cancel</wa-button>
    <wa-button slot="footer" appearance="accent" variant="danger"
               @click="revokeAllDevices()">Sign all out</wa-button>
  </wa-dialog>

  <!-- Admin only. The menu item is hidden for everyone else and every route behind it re-checks
       on the server, so this dialog existing in the DOM grants nothing. -->
  <wa-dialog label="Users" class="acctdlg" data-dialog="users" :open="dialog === 'users'" @wa-hide="if ($event.target === $el) closeDialog('users')">
    <p class="dlg__lead">Each user has their own private recipes and library.</p>

    <wa-spinner x-show="users.loading" class="centered"></wa-spinner>
    <wa-callout variant="danger" size="small" x-show="users.error">
      <span x-text="users.error"></span>
    </wa-callout>

    <template x-for="u in users.rows" :key="u.id">
      <div class="acctrow">
        <div class="acctrow__main">
          <span class="acctrow__name">
            <span x-text="u.username"></span>
            <small class="acctrow__self" x-show="u.isSelf">(you)</small>
          </span>
          <span class="wa-caption-xs" x-text="u.isAdmin ? 'Administrator' : 'User'"></span>
        </div>
        <wa-dropdown>
          <wa-button slot="trigger" size="small" appearance="plain"
                     :title="'Actions for ' + u.username">
            <wa-icon name="ellipsis-vertical" :label="'Actions for ' + u.username"></wa-icon>
          </wa-button>
          <wa-dropdown-item @click="pendingUserPassword = { user: u, password: '' }">
            <wa-icon slot="icon" name="key"></wa-icon> Reset password…
          </wa-dropdown-item>
          <wa-dropdown-item @click="setUserAdmin(u, !u.isAdmin)">
            <wa-icon slot="icon" :name="u.isAdmin ? 'user-minus' : 'user-shield'"></wa-icon>
            <span x-text="u.isAdmin ? 'Revoke administrator' : 'Make administrator'"></span>
          </wa-dropdown-item>
          <wa-divider></wa-divider>
          <wa-dropdown-item variant="danger" :disabled="u.isSelf"
                            @click="pendingUserDelete = u">
            <wa-icon slot="icon" name="trash"></wa-icon> Delete user…
          </wa-dropdown-item>
        </wa-dropdown>
      </div>
    </template>

    <wa-details summary="Add a user" class="acctadd">
      <form class="wa-stack wa-gap-s" @submit.prevent="createUser()">
        <wa-input label="Username" with-label size="small" autocomplete="off"
                  x-model="users.newName"></wa-input>
        <wa-input label="Password" with-label size="small" type="password" password-toggle
                  autocomplete="new-password" x-model="users.newPassword"
                  :hint="`At least ${minPasswordLength} characters`"></wa-input>
        <!-- :checked + @change, not x-model: Alpine picks its checkbox binding off `el.type`,
             which a custom element does not have, so x-model would bind .value instead. -->
        <wa-checkbox :checked="users.newAdmin"
                     @change="users.newAdmin = $event.target.checked">Administrator (can manage users)</wa-checkbox>
        <wa-button size="small" appearance="accent" variant="brand" type="submit"
                   data-testid="create-user" :loading="users.creating"
                   :disabled="!newUserReady">Create user</wa-button>
      </form>
    </wa-details>

    <wa-button slot="footer" appearance="plain" @click="dismissDialog()">Done</wa-button>
  </wa-dialog>

  <wa-dialog label="Reset password" :open="!!pendingUserPassword"
             @wa-hide="pendingUserPassword = null">
    <template x-if="pendingUserPassword">
      <div class="wa-stack wa-gap-m">
        <p>Set a new password for
          <strong x-text="pendingUserPassword.user.username"></strong>. Their apps and browser
          sessions are all signed out.</p>
        <wa-input label="New password" with-label type="password" password-toggle
                  autocomplete="new-password" x-model="pendingUserPassword.password"
                  :hint="`At least ${minPasswordLength} characters`"
                  @keydown.enter.prevent="resetUserPassword()"></wa-input>
      </div>
    </template>
    <wa-button slot="footer" appearance="plain" @click="pendingUserPassword = null">Cancel</wa-button>
    <wa-button slot="footer" appearance="accent" variant="brand"
               :disabled="!pendingUserPassword || pendingUserPassword.password.length < minPasswordLength"
               @click="resetUserPassword()">Set password</wa-button>
  </wa-dialog>

  <wa-dialog label="Delete user" :open="!!pendingUserDelete" @wa-hide="pendingUserDelete = null">
    <p>Delete <strong x-text="pendingUserDelete ? pendingUserDelete.username : ''"></strong> and
      every recipe, image and list they own? This cannot be undone.</p>
    <wa-button slot="footer" appearance="plain" @click="pendingUserDelete = null">Cancel</wa-button>
    <wa-button slot="footer" appearance="accent" variant="danger"
               @click="deleteUser()">Delete user</wa-button>
  </wa-dialog>

  <wa-dialog label="About Salty" class="aboutdlg" data-dialog="about" :open="dialog === 'about'"
             @wa-hide="if ($event.target === $el) closeDialog('about')">
    <div class="about wa-stack wa-gap-m wa-align-items-center">
      <span class="about__mark" aria-hidden="true">&#129474;</span>
      <strong class="about__name">Salty Server</strong>
      <dl class="about__facts">
        <dt>Version</dt><dd x-text="build.version"></dd>
        <dt>Build</dt><dd x-text="build.buildTime"></dd>
        <dt>Signed in as</dt><dd x-text="username"></dd>
      </dl>
    </div>
    <wa-button slot="footer" appearance="plain" @click="dismissDialog()">Close</wa-button>
  </wa-dialog>

  <!-- The stack is the component's own, and the reason is not tidiness: wa-dialog is a native
       <dialog> opened with showModal(), which paints in the browser's TOP LAYER, and nothing in the
       ordinary document reaches that no matter its z-index. A hand-rolled `position: fixed` stack
       put every toast raised from inside a dialog — user created, app removed, tag added, image
       rejected, every library rename — under the modal backdrop, dimmed and unreadable. wa-toast
       shows itself as a manual popover, which is in the top layer too, so it stacks above.
       It brings the announcement semantics as well: it mounts its own live region and announces
       `danger` assertively as an alert, everything else politely. One aria-live="polite" container
       could not make that distinction. Items are created from notify() in app.js. -->
  <wa-toast placement="bottom-end"></wa-toast>
</wa-page>

</body>
</html>
