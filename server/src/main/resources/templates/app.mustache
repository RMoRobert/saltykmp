<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{{pageTitle}}</title>
    <link rel="icon" href="/static/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/static/icon-192.png" sizes="192x192" type="image/png">
    <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">

    <!-- The whole UI is React + Fluent UI v9, built by Vite from server/src/main/webapp and copied
         into the jar by processResources. This page's only jobs are to hand the app its session
         config and to not flash white before React's first paint.

         Fluent styles itself through Griffel at runtime, so there is no stylesheet to link: the
         bundle is the entire front end. Filenames are fixed (not content-hashed) so this shell can
         name them; see the note in vite.config.js. -->
    <style>
      html, body, #root { height: 100%; margin: 0; }
      body { overflow: hidden; background: #ffffff; }
      /* Fluent's webDarkTheme neutral background, so the pre-paint page matches the app that is
         about to render over it rather than flashing white at a dark-mode reader. */
      @media (prefers-color-scheme: dark) { body { background: #292929; } }
    </style>
</head>
<body>

<!-- Config travels in data attributes, not as JS string literals. Mustache escapes for HTML, which
     is the correct escaper for an attribute value but the wrong one inside <script>: a backslash in
     a username passed through untouched and started a bogus \u escape, throwing a SyntaxError that
     left the config undefined, the CSRF token empty, and every write rejected with 403. -->
<div id="salty-config" hidden
     data-csrf="{{csrfToken}}"
     data-username="{{username}}"
     data-is-admin="{{#isAdmin}}true{{/isAdmin}}{{^isAdmin}}false{{/isAdmin}}"
     data-version="{{version}}"
     data-build-time="{{buildTime}}"
     data-min-password-length="{{minPasswordLength}}"></div>

<div id="root"></div>

<script type="module" src="/static/app/salty.js"></script>

<noscript>
  <p style="font: 16px system-ui; padding: 2rem">
    Salty's editor needs JavaScript. The <a href="/classic">classic view</a> does not.
  </p>
</noscript>

</body>
</html>
