{{<layoutSidebar.mustache}}
{{$content}}
<h1>{{heading}}</h1>
{{#isEmpty}}<p class="empty">{{emptyMessage}}</p>{{/isEmpty}}
{{^isEmpty}}
<ul class="browse-list">
    {{#items}}
    <li><a href="{{href}}" class="browse-item"><span class="browse-name">{{name}}</span><span class="browse-count">{{count}}</span></a></li>
    {{/items}}
</ul>
{{/isEmpty}}
{{#createListForm}}
<form method="post" action="/classic/shoppingLists" class="inline-form create-list-form">
    <input type="hidden" name="csrf" value="{{csrfToken}}">
    <input type="text" name="name" placeholder="New list name…" aria-label="New list name" required>
    <select name="type" aria-label="List type">
        <option value="checklist">Checklist</option>
        <option value="freeform">Freeform</option>
    </select>
    <button type="submit">Create</button>
</form>
{{/createListForm}}
{{/content}}
{{/layoutSidebar.mustache}}
