<!-- Nav for the classic (legacy) pages only. It is deliberately thin: account, user and library
     management all live in the app at /app now, so what is left here is browsing plus a way back. -->
<nav>
    <ul>
        {{#showHamburger}}<li><label class="hamburger" for="navtoggle" aria-label="Toggle menu">☰</label></li>{{/showHamburger}}
        <li><a href="/classic" class="nav-brand"><img class="nav-brand__logo" src="/static/icon-192.png" alt="" width="24" height="24"><strong>Salty</strong></a> <small class="classic-tag">Classic</small></li>
    </ul>
    <ul>
        {{#loggedIn}}<li><a href="/app" class="app-link">Back to app</a></li>{{/loggedIn}}
        {{^loggedIn}}<li><a href="/login">Log in</a></li>{{/loggedIn}}
    </ul>
</nav>
