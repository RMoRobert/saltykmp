<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>Salty - {{pageTitle}}</title>

    <!-- Web Awesome 3 (MIT). Note dist-cdn, not dist: the dist/ build has bare module specifiers a
         browser can't resolve, and every component silently fails to upgrade. Version pinned —
         a floating major would be a silent redesign. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/styles/webawesome.css">
    <!-- Swapped live by the theme picker in the account menu. Web Awesome ships three:
         default, awesome, shoelace. -->
    <link id="wa-theme" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/styles/themes/default.css">
    <!-- Web Awesome's own utility layer. utilities/fouce.css is their flash-of-undefined-elements
         fix and prose.css is their long-form typography — both were things I had hand-rolled. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/styles/utilities.css">
    <link rel="stylesheet" href="/static/app/editor.css">

    <script type="module"
            src="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/webawesome.loader.js"></script>

    <!-- Alpine plugins register before Alpine itself, hence the order. -->
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/sort@3.16.3/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/focus@3.16.3/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.16.3/dist/cdn.min.js"></script>
    <script src="/static/app/editor.js"></script>
</head>
<body>

<script>
  window.SALTY = {
    csrfToken: "{{csrfToken}}",
    username: "{{username}}",
    isAdmin: {{#isAdmin}}true{{/isAdmin}}{{^isAdmin}}false{{/isAdmin}}
  };
</script>

<!-- No x-init: Alpine calls init() on the x-data object automatically. Declaring both runs it
     twice and races two loadList() calls.

     Structure comes from <wa-page>, which supplies the responsive navigation-to-drawer behaviour,
     the toggle wiring and a skip-to-content link. It deliberately renders no sectioning elements of
     its own, so the real <header>, <nav> and <main> landmarks below are ours to provide. -->
<wa-page id="app" x-data="saltyEditor()" x-cloak mobile-breakpoint="768"
         :data-pane="pane" :data-rail="railOpen ? 'true' : 'false'">

  <header slot="header" class="appbar">
    <!-- Deliberately NOT data-toggle-nav: wa-page hides elements carrying that hook on desktop,
         because a drawer toggle is a mobile idea. One button should do the obvious thing on both,
         so it opens the drawer below the breakpoint and collapses the rail above it. -->
    <wa-button data-testid="hamburger" appearance="plain" size="small"
               @click="toggleSidebar()"
               :title="railOpen ? 'Hide sidebar' : 'Show sidebar'">
      <wa-icon name="bars" :label="railOpen ? 'Hide sidebar' : 'Show sidebar'"></wa-icon>
    </wa-button>

    <span class="appbar__brand"><span aria-hidden="true">&#127858;</span> <strong>Salty</strong></span>

    <wa-dropdown class="appbar__account">
      <wa-button slot="trigger" appearance="plain" size="small" title="Account">
        <wa-icon name="circle-user" label="Account"></wa-icon>
      </wa-button>
      <wa-dropdown-item disabled>Signed in as <strong x-text="username"></strong></wa-dropdown-item>
      <wa-divider></wa-divider>
      <wa-dropdown-item>
        Theme
        <wa-dropdown-item slot="submenu" @click="setTheme('default')"
                          :checked="theme === 'default'" type="checkbox">Default</wa-dropdown-item>
        <wa-dropdown-item slot="submenu" @click="setTheme('awesome')"
                          :checked="theme === 'awesome'" type="checkbox">Awesome</wa-dropdown-item>
        <wa-dropdown-item slot="submenu" @click="setTheme('shoelace')"
                          :checked="theme === 'shoelace'" type="checkbox">Shoelace</wa-dropdown-item>
      </wa-dropdown-item>
      <wa-dropdown-item type="link" href="/">
        <wa-icon slot="icon" name="table-list"></wa-icon> Classic view
      </wa-dropdown-item>
      <wa-divider></wa-divider>
      <wa-dropdown-item type="link" href="/logout">
        <wa-icon slot="icon" name="right-from-bracket"></wa-icon> Log out
      </wa-dropdown-item>
    </wa-dropdown>
  </header>

  <!-- ═══════════════ navigation · the library ═══════════════
       A wa-tree, not hand-rolled buttons: the sidebar really is a disclosure outline (sections
       expand and collapse), so role="tree" is accurate, and single-selection, keyboard navigation
       and the expand/collapse chevrons all come from the component. -->
  <nav slot="navigation" class="rail" aria-label="Library">
    <p class="rail__heading">Library</p>

    <wa-tree selection="single" class="railtree" @wa-selection-change="onTreeSelect($event)">
      <wa-tree-item data-kind="all" :selected="filter.kind === 'all'">
        <wa-icon name="book-open" class="railicon"></wa-icon> All Recipes
        <span class="railcount" x-text="list.length"></span>
      </wa-tree-item>

      <wa-tree-item data-kind="favorites" :selected="filter.kind === 'favorites'">
        <wa-icon name="heart" class="railicon"></wa-icon> Favorites
        <span class="railcount" x-text="favoriteCount"></span>
      </wa-tree-item>

      <wa-tree-item data-kind="wantToMake" :selected="filter.kind === 'wantToMake'">
        <wa-icon name="bookmark" class="railicon"></wa-icon> Want to Make
        <span class="railcount" x-text="wantToMakeCount"></span>
      </wa-tree-item>

      <template x-for="group in libraryGroups" :key="group.kind">
        <wa-tree-item :expanded="group.kind === 'category'" data-group>
          <span x-text="group.label"></span>
          <span class="railcount" x-text="group.items.length"></span>

          <template x-for="item in group.items" :key="item.id">
            <wa-tree-item :data-kind="group.kind" :data-id="item.id"
                          :selected="filter.kind === group.kind && filter.id === item.id">
              <wa-icon :name="group.icon" class="railicon"></wa-icon>
              <span x-text="item.name || 'Untitled'"></span>
              <span class="railcount" x-text="countFor(group.kind, item.id)"></span>
            </wa-tree-item>
          </template>
        </wa-tree-item>
      </template>

      <wa-tree-item data-group>
        <span>Shopping Lists</span>
        <wa-tree-item data-href="/shoppingLists">
          <wa-icon name="cart-shopping" class="railicon"></wa-icon> All Lists
        </wa-tree-item>
      </wa-tree-item>
    </wa-tree>
  </nav>

  <!-- ═══════════════ main · recipe list + recipe ═══════════════ -->
  <main class="panes">
  <section class="list" aria-label="Recipes">
    <header class="list__head">
      <wa-button class="only-compact" size="small" appearance="plain" @click="railOpen = true; pane = 'rail'">
        <wa-icon slot="start" name="chevron-left"></wa-icon> Library
      </wa-button>
      <h2 class="list__title" x-text="filter.label"></h2>
      <wa-button size="small" appearance="filled" @click="createRecipe()" title="New recipe">
        <wa-icon name="plus" label="New recipe"></wa-icon>
      </wa-button>
    </header>

    <div class="list__search">
      <wa-input size="small" placeholder="Search recipes" x-model="query" with-clear>
        <wa-icon slot="start" name="magnifying-glass"></wa-icon>
      </wa-input>
    </div>

    <div class="list__scroll">
      <wa-spinner x-show="listLoading" class="centered"></wa-spinner>
      <wa-callout variant="danger" size="small" x-show="loadError" class="m-2">
        <span x-text="loadError"></span>
      </wa-callout>

      <template x-for="r in visibleRecipes" :key="r.id">
        <button type="button" class="rrow" :class="{ 'rrow--on': r.id === selectedId }"
                @click="open(r.id)" :aria-current="r.id === selectedId">
          <span class="rrow__name" x-text="r.name || 'Untitled'"></span>
          <span class="rrow__meta" x-text="rowMeta(r)"></span>
        </button>
      </template>

      <p class="empty" x-show="!listLoading && !visibleRecipes.length"
         x-text="query ? 'No matches' : 'Nothing here yet'"></p>
    </div>
  </section>

  <!-- ═══════════════════ pane 3 · recipe ═══════════════════ -->
  <main class="detail">
    <header class="detail__bar">
      <wa-button class="only-compact" size="small" appearance="plain" @click="backToList()">
        <wa-icon slot="start" name="chevron-left"></wa-icon> Recipes
      </wa-button>

      <h1 class="detail__title" x-text="current ? (current.name || 'Untitled') : ''"></h1>

      <template x-if="current">
        <div class="detail__actions">
          <!-- Read is the default; Edit is an action, matching the Swift and CMP apps. -->
          <template x-if="mode === 'read'">
            <wa-button data-testid="edit" size="small" appearance="outlined" @click="mode = 'edit'">
              <wa-icon slot="start" name="pen"></wa-icon> Edit
            </wa-button>
          </template>
          <template x-if="mode === 'edit'">
            <wa-button data-testid="done" size="small" appearance="accent" variant="brand"
                       :loading="saving" @click="saveAndClose()">Done</wa-button>
          </template>

          <wa-dropdown>
            <wa-button slot="trigger" size="small" appearance="plain" title="More actions">
              <wa-icon name="ellipsis-vertical" label="More actions"></wa-icon>
            </wa-button>
            <wa-dropdown-item @click="createRecipe()">
              <wa-icon slot="icon" name="plus"></wa-icon> New recipe
            </wa-dropdown-item>
            <wa-divider></wa-divider>
            <wa-dropdown-item variant="danger" @click="confirmDelete = true">
              <wa-icon slot="icon" name="trash"></wa-icon> Delete recipe…
            </wa-dropdown-item>
          </wa-dropdown>
        </div>
      </template>
    </header>

    <div class="doc">
      <wa-spinner x-show="loadingRecipe" class="centered"></wa-spinner>

      <div class="empty-state" x-show="!current && !loadingRecipe">
        <wa-icon name="book-open" class="empty-state__icon"></wa-icon>
        <p>Select a recipe.</p>
      </div>

      <template x-if="current">
        <article class="doc__inner">

          <!-- ─────────── READ ─────────── -->
          <template x-if="mode === 'read'">
            <div class="read">
              <h2 class="read__title" x-text="current.name || 'Untitled'"></h2>

              <p class="read__meta">
                <template x-if="courseName(current.courseId)">
                  <span><span x-text="courseName(current.courseId)"></span> · </span>
                </template>
                <template x-if="current.yield"><span x-text="current.yield"></span></template>
                <template x-if="current.servings">
                  <span> · Serves <span x-text="current.servings"></span></span>
                </template>
                <template x-if="current.rating">
                  <span> · <span class="stars" x-text="'★'.repeat(current.rating)"></span></span>
                </template>
              </p>

              <template x-if="current.introduction">
                <p class="read__intro" x-text="current.introduction"></p>
              </template>

              <div class="read__chips" x-show="chipsFor(current).length">
                <template x-for="c in chipsFor(current)" :key="c">
                  <wa-tag size="small" appearance="outlined" x-text="c"></wa-tag>
                </template>
              </div>

              <section class="read__sect" x-show="ingredients.length">
                <div class="read__secthead">
                  <h3>Ingredients</h3>
                  <div class="scaler">
                    <wa-button size="small" appearance="plain" @click="bumpScale(-1)" title="Halve">
                      <wa-icon name="minus" label="Decrease scale"></wa-icon>
                    </wa-button>
                    <output x-text="scaleLabel"></output>
                    <wa-button size="small" appearance="plain" @click="bumpScale(1)" title="Double">
                      <wa-icon name="plus" label="Increase scale"></wa-icon>
                    </wa-button>
                  </div>
                </div>
                <ul class="read__list">
                  <template x-for="row in ingredients" :key="row.id">
                    <li :class="{ 'is-heading': row.isHeading, 'is-main': row.isMain }">
                      <span x-show="row.isHeading" x-text="row.text"></span>
                      <span x-show="!row.isHeading" x-html="scaledHTML(row.text)"></span>
                    </li>
                  </template>
                </ul>
              </section>

              <section class="read__sect" x-show="directions.length">
                <h3>Directions</h3>
                <!-- A <ul> with explicit numbers, not an <ol>: section headings are list items
                     too, and an <ol> counts them, so every heading shifted the numbering. -->
                <ul class="read__steps">
                  <template x-for="(row, i) in directions" :key="row.id">
                    <li :class="{ 'is-heading': row.isHeading }">
                      <template x-if="!row.isHeading">
                        <span class="stepno" x-text="stepNumber(i) + '.'"></span>
                      </template>
                      <span x-text="row.text"></span>
                    </li>
                  </template>
                </ul>
              </section>

              <p class="read__footer">
                <template x-if="current.source">
                  <span>Source: <strong x-text="current.source"></strong>
                    <template x-if="current.sourceDetails">
                      <span> — <span x-text="current.sourceDetails"></span></span>
                    </template>
                  </span>
                </template>
                <template x-if="current.lastPrepared">
                  <span class="read__made">Last made <span x-text="relativeDate(current.lastPrepared)"></span></span>
                </template>
              </p>
            </div>
          </template>

          <!-- ─────────── EDIT ─────────── -->
          <template x-if="mode === 'edit'">
            <div class="edit">
              <wa-input class="titlefield" x-model="current.name" @input="touch()"
                        aria-label="Recipe name" size="large"></wa-input>

              <wa-card class="sect">
                <div slot="header" class="sect__head">
                  <h3>Ingredients</h3>
                  <wa-badge variant="neutral" x-text="ingCount + ' items'"></wa-badge>
                </div>
                <ul class="rows" x-sort="(item, pos) => reorder('ingredients', item, pos)"
                    x-sort:config="{ handle: '.grip' }">
                  <template x-for="(row, i) in ingredients" :key="row.id">
                    <li class="row" :class="{ 'row--heading': row.isHeading, 'row--main': row.isMain }"
                        x-sort:item="row.id">
                      <span class="grip" title="Drag to reorder" aria-hidden="true">
                        <wa-icon name="grip-vertical"></wa-icon>
                      </span>
                      <span class="row__lead" x-text="row.isHeading ? '' : '•'"></span>
                      <wa-textarea class="row__edit" x-model="row.text" @input="touch()"
                                   resize="auto" rows="1"
                                   :aria-label="(row.isHeading ? 'Heading ' : 'Ingredient ') + (i + 1)"></wa-textarea>
                      <span class="row__tools">
                        <wa-button size="small" appearance="plain" x-show="!row.isHeading"
                                   @click="row.isMain = !row.isMain; touch()"
                                   :title="row.isMain ? 'Main ingredient' : 'Mark as main ingredient'">
                          <wa-icon name="star" :variant="row.isMain ? 'solid' : 'regular'"
                                   label="Mark as main ingredient"></wa-icon>
                        </wa-button>
                        <wa-button size="small" appearance="plain" @click="removeRow('ingredients', i)" title="Delete">
                          <wa-icon name="xmark" label="Delete row"></wa-icon>
                        </wa-button>
                      </span>
                    </li>
                  </template>
                </ul>
                <div slot="footer" class="sect__foot">
                  <wa-button size="small" appearance="filled" @click="addRow('ingredients', false)">
                    <wa-icon slot="start" name="plus"></wa-icon> Ingredient
                  </wa-button>
                  <wa-button size="small" appearance="plain" @click="addRow('ingredients', true)">
                    <wa-icon slot="start" name="heading"></wa-icon> Section heading
                  </wa-button>
                </div>
              </wa-card>

              <wa-card class="sect">
                <div slot="header" class="sect__head">
                  <h3>Directions</h3>
                  <wa-badge variant="neutral" x-text="dirCount + ' steps'"></wa-badge>
                </div>
                <ul class="rows" x-sort="(item, pos) => reorder('directions', item, pos)"
                    x-sort:config="{ handle: '.grip' }">
                  <template x-for="(row, i) in directions" :key="row.id">
                    <li class="row" :class="{ 'row--heading': row.isHeading }" x-sort:item="row.id">
                      <span class="grip" title="Drag to reorder" aria-hidden="true">
                        <wa-icon name="grip-vertical"></wa-icon>
                      </span>
                      <span class="row__lead" x-text="row.isHeading ? '' : stepNumber(i) + '.'"></span>
                      <wa-textarea class="row__edit" x-model="row.text" @input="touch()"
                                   resize="auto" rows="1"
                                   :aria-label="(row.isHeading ? 'Heading ' : 'Step ') + (i + 1)"></wa-textarea>
                      <span class="row__tools">
                        <wa-button size="small" appearance="plain" @click="removeRow('directions', i)" title="Delete">
                          <wa-icon name="xmark" label="Delete row"></wa-icon>
                        </wa-button>
                      </span>
                    </li>
                  </template>
                </ul>
                <div slot="footer" class="sect__foot">
                  <wa-button size="small" appearance="filled" @click="addRow('directions', false)">
                    <wa-icon slot="start" name="plus"></wa-icon> Step
                  </wa-button>
                  <wa-button size="small" appearance="plain" @click="addRow('directions', true)">
                    <wa-icon slot="start" name="heading"></wa-icon> Section heading
                  </wa-button>
                </div>
              </wa-card>

              <wa-card class="sect">
                <div slot="header" class="sect__head"><h3>Details</h3></div>
                <div class="grid">
                  <wa-input label="Yield" with-label x-model="current.yield" @input="touch()"></wa-input>
                  <wa-input label="Servings" with-label type="number"
                            x-model.number="current.servings" @input="touch()"></wa-input>
                  <wa-select label="Course" with-label x-model="current.courseId" @change="touch()">
                    <wa-option value="">None</wa-option>
                    <template x-for="c in courses" :key="c.id">
                      <wa-option :value="c.id" x-text="c.name"></wa-option>
                    </template>
                  </wa-select>
                  <wa-select label="Difficulty" with-label x-model.number="current.difficulty" @change="touch()">
                    <wa-option value="0">Not set</wa-option>
                    <wa-option value="1">Easy</wa-option>
                    <wa-option value="2">Moderate</wa-option>
                    <wa-option value="3">Hard</wa-option>
                  </wa-select>

                  <div class="field">
                    <label class="field__label">Rating</label>
                    <!-- width:max-content in CSS: wa-rating is role=slider and maps click position
                         across its element width, so a stretched box makes the last star unhittable. -->
                    <wa-rating class="rating-field" label="Rating" :value="current.rating || 0"
                               @change="current.rating = Number($event.target.value); touch()"></wa-rating>
                  </div>

                  <div class="field">
                    <label class="field__label" for="lastPrepared">Last made on</label>
                    <input class="native-date" type="date" id="lastPrepared"
                           :value="dateOnly(current.lastPrepared)"
                           @change="setLastPrepared($event.target.value)">
                  </div>

                  <wa-input label="Source" with-label x-model="current.source" @input="touch()"></wa-input>
                  <wa-input label="Source details" with-label x-model="current.sourceDetails" @input="touch()"></wa-input>
                </div>

                <wa-textarea class="intro" label="Introduction" with-label resize="auto" rows="2"
                             x-model="current.introduction" @input="touch()"></wa-textarea>
              </wa-card>
            </div>
          </template>

        </article>
      </template>
    </div>

    <footer class="savebar" x-show="current && mode === 'edit'">
      <span class="savebar__status" :class="{ 'is-dirty': dirty }"
            x-text="dirty ? 'Unsaved changes' : 'All changes saved'"></span>
      <wa-button size="small" appearance="plain" :disabled="!dirty" @click="revert()">Revert</wa-button>
      <wa-button data-testid="save" size="small" appearance="accent" variant="brand" :disabled="!dirty"
                 :loading="saving" @click="save()">Save</wa-button>
    </footer>
  </main>

  </main>

  <wa-dialog label="Delete recipe" :open="confirmDelete" @wa-hide="confirmDelete = false">
    <p>Delete “<strong x-text="current ? current.name : ''"></strong>”? This removes it from every
       synced device and can't be undone.</p>
    <wa-button slot="footer" appearance="plain" @click="confirmDelete = false">Cancel</wa-button>
    <wa-button slot="footer" variant="danger" appearance="accent" @click="doDelete()">Delete</wa-button>
  </wa-dialog>

  <div class="toasts" aria-live="polite">
    <template x-for="t in toasts" :key="t.id">
      <wa-callout :variant="t.variant" class="toast">
        <wa-icon slot="icon" :name="t.variant === 'danger' ? 'circle-exclamation' : 'circle-check'"></wa-icon>
        <span x-text="t.text"></span>
      </wa-callout>
    </template>
  </div>
</wa-page>

</body>
</html>
