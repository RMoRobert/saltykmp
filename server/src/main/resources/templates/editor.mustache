<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>Salty - {{pageTitle}}</title>

    <!-- Web Awesome 3 (MIT). Note dist-cdn, not dist: the dist/ build has bare module specifiers a
         browser can't resolve, and every component silently fails to upgrade. Version pinned —
         a floating major would be a silent redesign. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/styles/webawesome.css">
    <!-- Light and dark both come from the OS via <meta name="color-scheme">; there is no theme
         control, as Web Awesome's three themes are near-identical for the components used here. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/styles/themes/default.css">
    <!-- Web Awesome's own utility layer. utilities/fouce.css is their flash-of-undefined-elements
         fix and prose.css is their long-form typography — both were things I had hand-rolled. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/styles/utilities.css">
    <link rel="stylesheet" href="/static/app/editor.css">

    <!-- Web Awesome's themes switch on a `wa-dark` class; they do NOT follow prefers-color-scheme
         on their own, so a dark-mode browser rendered the whole app light until this ran. Inline
         and ahead of first paint, or a dark-mode user gets a white flash on every load. -->
    <script>
      (function () {
        var m = window.matchMedia("(prefers-color-scheme: dark)");
        var apply = function () { document.documentElement.classList.toggle("wa-dark", m.matches); };
        apply();
        m.addEventListener("change", apply);
      })();
    </script>

    <script type="module"
            src="https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.12.0/dist-cdn/webawesome.loader.js"></script>

    <!-- Alpine plugins register before Alpine itself, hence the order. -->
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/sort@3.16.3/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/focus@3.16.3/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.16.3/dist/cdn.min.js"></script>
    <script src="/static/app/editor.js"></script>
</head>
<body>

<!-- Config travels in data attributes, not as JS string literals. Mustache escapes for HTML, which
     is the correct escaper for an attribute value but the wrong one inside <script>: a backslash in
     a username passed through untouched and started a bogus \u escape, throwing a SyntaxError that
     left window.SALTY undefined, the CSRF token empty, and every write rejected with 403. -->
<div id="salty-config" hidden
     data-csrf="{{csrfToken}}"
     data-username="{{username}}"
     data-is-admin="{{#isAdmin}}true{{/isAdmin}}{{^isAdmin}}false{{/isAdmin}}"></div>

<!-- No x-init: Alpine calls init() on the x-data object automatically. Declaring both runs it
     twice and races two loadList() calls.

     Structure comes from <wa-page>, which supplies the responsive navigation-to-drawer behaviour,
     the toggle wiring and a skip-to-content link. It deliberately renders no sectioning elements of
     its own, so the real <header>, <nav> and <main> landmarks below are ours to provide. -->
<wa-page id="app" x-data="saltyEditor()" x-cloak mobile-breakpoint="768px"
         :data-pane="pane">

  <!-- wa-split does the layout (brand at one end, account at the other); the stylesheet only
       supplies the inset, since wa-page's header part has no padding of its own. -->
  <header slot="header" class="appbar wa-split wa-align-items-center">
    <!-- No hamburger here on purpose. wa-page renders its own navigation toggle and owns the
         drawer; a second hand-rolled button is what produced two of them side by side, and every
         workaround after that (data-toggle-nav, a !important override) was papering over it. -->

    <span class="appbar__brand"><span aria-hidden="true">&#127858;</span> <strong>Salty</strong></span>

    <wa-dropdown class="appbar__account">
      <wa-button slot="trigger" appearance="plain" size="small" title="Account">
        <wa-icon name="circle-user" label="Account"></wa-icon>
      </wa-button>
      <wa-dropdown-item disabled>Signed in as <strong x-text="username"></strong></wa-dropdown-item>
      <wa-divider></wa-divider>
      <wa-dropdown-item @click="openLibraryManager()">
        <wa-icon slot="icon" name="sliders"></wa-icon> Manage library…
      </wa-dropdown-item>
      <wa-dropdown-item type="link" href="/">
        <wa-icon slot="icon" name="table-list"></wa-icon> Classic view
      </wa-dropdown-item>
      <wa-divider></wa-divider>
      <wa-dropdown-item type="link" href="/logout">
        <wa-icon slot="icon" name="right-from-bracket"></wa-icon> Log out
      </wa-dropdown-item>
    </wa-dropdown>
  </header>

  <!-- ═══════════════ navigation · the library ═══════════════
       A wa-tree, not hand-rolled buttons: the sidebar really is a disclosure outline (sections
       expand and collapse), so role="tree" is accurate, and single-selection, keyboard navigation
       and the expand/collapse chevrons all come from the component. -->
  <nav slot="navigation" class="rail" aria-label="Library">
    <!-- selection="leaf": parents only expand and collapse, so the group rows can't be selected
         at all. All Recipes / Favorites / Want to Make have no children, so they stay selectable. -->
    <wa-tree selection="leaf" class="railtree" @wa-selection-change="onTreeSelect($event)">
      <wa-tree-item data-kind="all" :selected="filter.kind === 'all'">
        <wa-icon name="book-open"></wa-icon> All Recipes
      </wa-tree-item>

      <wa-tree-item data-kind="favorites" :selected="filter.kind === 'favorites'">
        <wa-icon name="heart" variant="regular"></wa-icon>
        Favorites
      </wa-tree-item>

      <wa-tree-item data-kind="wantToMake" :selected="filter.kind === 'wantToMake'">
        <wa-icon name="bookmark" variant="regular"></wa-icon>
        Want to Make
      </wa-tree-item>

      <template x-for="group in libraryGroups" :key="group.kind">
        <wa-tree-item :expanded="group.kind === 'category'" data-group
                      :disabled="!group.items.length">
          <span x-text="group.label"></span>

          <template x-for="item in group.items" :key="item.id">
            <wa-tree-item :data-kind="group.kind" :data-id="item.id"
                          :selected="filter.kind === group.kind && filter.id === item.id">
              <wa-icon :name="group.icon" :variant="group.outline ? 'regular' : 'solid'"></wa-icon>
              <span x-text="item.name || 'Untitled'"></span>
            </wa-tree-item>
          </template>
        </wa-tree-item>
      </template>

      <wa-tree-item data-kind="shopping" :selected="section === 'shopping'">
        <wa-icon name="cart-shopping"></wa-icon> Shopping Lists
      </wa-tree-item>
    </wa-tree>
  </nav>

  <!-- ═══════════════ main · recipe list + recipe ═══════════════ -->
  <!-- Exactly one <main>, and it carries the id wa-page's skip-to-content link points at. The
       three panes inside are <section>s: nesting <main> inside <main> is invalid and exposed two
       unlabelled landmarks at once. -->
  <main class="panes" id="main-content">
  <section class="list" aria-label="Recipes" x-show="section === 'recipes'">
    <header class="list__head wa-split wa-align-items-center">
      <wa-button class="only-compact" size="small" appearance="plain" @click="showLibrary()">
        <wa-icon slot="start" name="chevron-left"></wa-icon> Library
      </wa-button>
      <h2 class="list__title" x-text="filter.label"></h2>
      <wa-button size="small" appearance="filled" @click="createRecipe()" title="New recipe">
        <wa-icon name="plus" label="New recipe"></wa-icon>
      </wa-button>
    </header>

    <div class="list__search">
      <wa-input size="small" placeholder="Search recipes" x-model="query" with-clear>
        <wa-icon slot="start" name="magnifying-glass"></wa-icon>
      </wa-input>
    </div>

    <div class="list__scroll">
      <wa-spinner x-show="listLoading" class="centered"></wa-spinner>
      <wa-callout variant="danger" size="small" x-show="loadError" class="m-2">
        <span x-text="loadError"></span>
      </wa-callout>

      <template x-for="r in visibleRecipes" :key="r.id">
        <!-- wa-flank puts the thumbnail beside the text, wa-frame crops it to a square without
             distorting it, and wa-stack spaces the lines: all Web Awesome layout utilities, so the
             only thing left for the stylesheet is the flank width and the row's own hit area. -->
        <button type="button" class="rrow" :class="{ 'rrow--on': r.id === selectedId }"
                @click="open(r.id)" :aria-current="r.id === selectedId">
          <!-- The flank sits on a span inside the button rather than on the button itself: flex
               layout on a <button> has a long history of engine quirks, and a plain element is what
               the utility expects. (The row's height comes from .rrow in the stylesheet, which
               undoes the form-control height Web Awesome gives every bare button.) -->
          <span class="rrow__inner wa-flank wa-gap-s">
          <span class="rrow__thumb wa-frame:square">
            <template x-if="thumbUrl(r)">
              <img :src="thumbUrl(r)" alt="" loading="lazy" decoding="async">
            </template>
            <template x-if="!thumbUrl(r)">
              <wa-icon name="book-open" class="rrow__noimage"></wa-icon>
            </template>
          </span>

          <span class="rrow__text wa-stack wa-gap-3xs">
            <span class="rrow__name" x-text="r.name || 'Untitled'"></span>
            <template x-if="rowSubtitle(r)">
              <span class="rrow__sub" x-text="rowSubtitle(r)"></span>
            </template>
            <span class="rrow__marks wa-cluster wa-gap-2xs"
                  x-show="r.rating || r.isFavorite">
              <!-- readonly: the row is a link to the recipe, not a place to re-rate it. -->
              <wa-rating x-show="r.rating" readonly size="small" :value="r.rating || 0"
                         :label="(r.rating || 0) + ' out of 5'"></wa-rating>
              <wa-icon x-show="r.isFavorite" class="rrow__fav" name="heart" variant="solid"
                       label="Favorite"></wa-icon>
            </span>
          </span>
          </span>
        </button>
      </template>

      <p class="empty" x-show="!listLoading && !visibleRecipes.length"
         x-text="query ? 'No matches' : 'Nothing here yet'"></p>
    </div>
  </section>

  <!-- The same middle column, showing shopping lists. Mirrors the Swift client, where the content
       column lists the shopping lists and the detail column shows the one that's selected. -->
  <section class="list" aria-label="Shopping lists" x-show="section === 'shopping'">
    <header class="list__head wa-split wa-align-items-center">
      <wa-button class="only-compact" size="small" appearance="plain" @click="showLibrary()">
        <wa-icon slot="start" name="chevron-left"></wa-icon> Library
      </wa-button>
      <h2 class="list__title">Shopping Lists</h2>
      <wa-button size="small" appearance="filled" @click="createList()" title="New list">
        <wa-icon name="plus" label="New list"></wa-icon>
      </wa-button>
    </header>

    <div class="list__scroll">
      <wa-spinner x-show="shoppingListsLoading" class="centered"></wa-spinner>
      <template x-for="l in shoppingLists" :key="l.id">
        <button type="button" class="rrow" :class="{ 'rrow--on': l.id === selectedListId }"
                @click="openList(l.id)" :aria-current="l.id === selectedListId">
          <span class="rrow__name" x-text="l.name || 'Untitled'"></span>
          <span class="rrow__meta" x-text="listMeta(l)"></span>
        </button>
      </template>
      <p class="empty" x-show="!shoppingListsLoading && !shoppingLists.length">No lists yet</p>
    </div>
  </section>

  <!-- ═══════════════════ pane 3 · recipe ═══════════════════ -->
  <section class="detail" aria-label="Recipe" x-show="section === 'recipes'">
    <header class="detail__bar wa-split wa-align-items-center">
      <wa-button class="only-compact" size="small" appearance="plain" @click="backToList()">
        <wa-icon slot="start" name="chevron-left"></wa-icon> Recipes
      </wa-button>

      <h1 class="detail__title" x-text="current ? (current.name || 'Untitled') : ''"></h1>

      <template x-if="current">
        <div class="detail__actions wa-cluster wa-gap-2xs">
          <!-- Read is the default; Edit is an action, matching the Swift and CMP apps. -->
          <template x-if="mode === 'read'">
            <wa-button data-testid="edit" size="small" appearance="outlined" @click="mode = 'edit'">
              <wa-icon slot="start" name="pen"></wa-icon> Edit
            </wa-button>
          </template>

          <wa-dropdown>
            <wa-button slot="trigger" size="small" appearance="plain" title="More actions">
              <wa-icon name="ellipsis-vertical" label="More actions"></wa-icon>
            </wa-button>
            <wa-dropdown-item @click="createRecipe()">
              <wa-icon slot="icon" name="plus"></wa-icon> New recipe
            </wa-dropdown-item>
            <wa-divider></wa-divider>
            <wa-dropdown-item variant="danger" @click="confirmDelete = true">
              <wa-icon slot="icon" name="trash"></wa-icon> Delete recipe…
            </wa-dropdown-item>
          </wa-dropdown>
        </div>
      </template>
    </header>

    <div class="doc">
      <wa-spinner x-show="loadingRecipe" class="centered"></wa-spinner>

      <div class="empty-state" x-show="!current && !loadingRecipe">
        <wa-icon name="book-open" class="empty-state__icon"></wa-icon>
        <p>Select a recipe.</p>
      </div>

      <template x-if="current">
        <article class="doc__inner">

          <!-- ─────────── READ ─────────── -->
          <template x-if="mode === 'read'">
            <div class="read">
              <h2 class="read__title" x-text="current.name || 'Untitled'"></h2>

              <template x-if="imageUrl">
                <img class="read__image" :src="imageUrl" alt="" loading="lazy">
              </template>

              <p class="read__meta">
                <template x-if="courseName(current.courseId)">
                  <span><span x-text="courseName(current.courseId)"></span> · </span>
                </template>
                <template x-if="current.yield"><span x-text="current.yield"></span></template>
                <template x-if="current.servings">
                  <span> · Serves <span x-text="current.servings"></span></span>
                </template>
                <template x-if="current.rating">
                  <span> · <span class="stars" x-text="'★'.repeat(current.rating)"></span></span>
                </template>
              </p>

              <template x-if="current.introduction">
                <p class="read__intro" x-text="current.introduction"></p>
              </template>

              <div class="read__chips" x-show="chipsFor(current).length">
                <template x-for="c in chipsFor(current)" :key="c">
                  <wa-tag size="small" appearance="outlined" x-text="c"></wa-tag>
                </template>
              </div>

              <section class="read__sect" x-show="ingredients.length">
                <div class="read__secthead">
                  <h3>Ingredients</h3>
                  <div class="scaler">
                    <wa-button size="small" appearance="plain" @click="bumpScale(-1)" title="Halve">
                      <wa-icon name="minus" label="Decrease scale"></wa-icon>
                    </wa-button>
                    <output x-text="scaleLabel"></output>
                    <wa-button size="small" appearance="plain" @click="bumpScale(1)" title="Double">
                      <wa-icon name="plus" label="Increase scale"></wa-icon>
                    </wa-button>
                  </div>
                </div>
                <ul class="read__list">
                  <template x-for="row in ingredients" :key="row.id">
                    <li :class="{ 'is-heading': row.isHeading, 'is-main': row.isMain }">
                      <span x-show="row.isHeading" x-text="row.text"></span>
                      <span x-show="!row.isHeading" x-html="scaledHTML(row.text)"></span>
                    </li>
                  </template>
                </ul>
              </section>

              <section class="read__sect" x-show="directions.length">
                <h3>Directions</h3>
                <!-- A <ul> with explicit numbers, not an <ol>: section headings are list items
                     too, and an <ol> counts them, so every heading shifted the numbering. -->
                <ul class="read__steps">
                  <template x-for="(row, i) in directions" :key="row.id">
                    <li :class="{ 'is-heading': row.isHeading }">
                      <template x-if="!row.isHeading">
                        <span class="stepno" x-text="stepNumber(i) + '.'"></span>
                      </template>
                      <span x-text="row.text"></span>
                    </li>
                  </template>
                </ul>
              </section>

              <template x-if="(current.preparationTimes || []).length">
                <section class="read__sect">
                  <h3>Times</h3>
                  <dl class="read__pairs wa-grid">
                    <template x-for="t in current.preparationTimes" :key="t.id">
                      <div class="read__pair">
                        <dt x-text="t.type"></dt>
                        <dd x-text="t.timeString"></dd>
                      </div>
                    </template>
                  </dl>
                </section>
              </template>

              <template x-if="(current.notes || []).length">
                <section class="read__sect">
                  <h3>Notes</h3>
                  <template x-for="n in current.notes" :key="n.id">
                    <div class="read__block">
                      <h4 x-text="n.title"></h4>
                      <p class="read__body" x-text="n.content"></p>
                    </div>
                  </template>
                </section>
              </template>

              <template x-if="(current.variations || []).length">
                <section class="read__sect">
                  <h3>Variations</h3>
                  <template x-for="v in current.variations" :key="v.id">
                    <div class="read__block">
                      <h4 x-text="v.variationName"></h4>
                      <p class="read__body" x-text="v.text"></p>
                    </div>
                  </template>
                </section>
              </template>

              <template x-if="hasNutrition">
                <section class="read__sect">
                  <h3>Nutrition</h3>
                  <dl class="read__pairs wa-grid">
                    <template x-for="row in nutritionRows" :key="row.label">
                      <div class="read__pair">
                        <dt x-text="row.label"></dt>
                        <dd x-text="row.value"></dd>
                      </div>
                    </template>
                  </dl>
                </section>
              </template>

              <p class="read__footer">
                <template x-if="current.source">
                  <span>Source: <strong x-text="current.source"></strong>
                    <template x-if="current.sourceDetails">
                      <span> — <span x-text="current.sourceDetails"></span></span>
                    </template>
                  </span>
                </template>
                <template x-if="current.lastPrepared">
                  <span class="read__made">Last made <span x-text="relativeDate(current.lastPrepared)"></span></span>
                </template>
              </p>
            </div>
          </template>

        </article>
      </template>
    </div>
  </section>

  <!-- ═══════════════════ pane 3 · shopping list ═══════════════════
       Unlike a recipe this edits in place with no Edit button: a shopping list is worked, not
       composed, and autosaves as items are ticked (see touchList). That's also what makes
       concurrent edits ordinary here rather than rare, hence the merge on 409. -->
  <section class="detail" aria-label="Shopping list" x-show="section === 'shopping'">
    <header class="detail__bar wa-split wa-align-items-center">
      <wa-button class="only-compact" size="small" appearance="plain" @click="pane = 'list'">
        <wa-icon slot="start" name="chevron-left"></wa-icon> Lists
      </wa-button>

      <h1 class="detail__title" x-text="currentList ? (currentList.name || 'Untitled') : ''"></h1>

      <template x-if="currentList">
        <div class="detail__actions wa-cluster wa-gap-2xs">
          <span class="savebar__status" :class="{ 'is-dirty': listDirty }"
                x-text="listSaving ? 'Saving…' : (listDirty ? 'Unsaved changes' : 'All changes saved')"></span>
          <wa-dropdown>
            <wa-button slot="trigger" size="small" appearance="plain" title="More actions">
              <wa-icon name="ellipsis-vertical" label="More actions"></wa-icon>
            </wa-button>
            <wa-dropdown-item @click="addListHeading()">
              <wa-icon slot="icon" name="heading"></wa-icon> Add section heading
            </wa-dropdown-item>
            <wa-dropdown-item @click="clearCompleted()">
              <wa-icon slot="icon" name="broom"></wa-icon> Clear completed
            </wa-dropdown-item>
            <wa-divider></wa-divider>
            <wa-dropdown-item variant="danger" @click="confirmDeleteList = true">
              <wa-icon slot="icon" name="trash"></wa-icon> Delete list…
            </wa-dropdown-item>
          </wa-dropdown>
        </div>
      </template>
    </header>

    <div class="doc">
      <div class="empty-state" x-show="!currentList">
        <wa-icon name="cart-shopping" class="empty-state__icon"></wa-icon>
        <p>Select a list.</p>
      </div>

      <template x-if="currentList">
        <div class="doc__inner slist">
          <wa-input class="titlefield" x-model="currentList.name" @input="touchList()"
                    aria-label="List name" size="large"></wa-input>

          <!-- A freeform list is a scratch pad, so it gets a text area and nothing else. This is
               also the one shape that cannot be merged item by item, which is why the server may
               answer a conflict with a whole second copy. -->
          <template x-if="currentList.isFreeform">
            <wa-textarea class="freeform" resize="auto" rows="12" aria-label="List contents"
                         x-model="currentList.contentsForFreeform" @input="touchList()"></wa-textarea>
          </template>

          <template x-if="!currentList.isFreeform">
            <div>
              <!-- Enter is handled on the input rather than by form submission: wa-input keeps its
                   real <input> in shadow DOM, so a form never sees the implicit submit. -->
              <div class="slist__add wa-cluster wa-gap-xs">
                <wa-input size="small" placeholder="Add an item" x-model="newItemText"
                          aria-label="Add an item" @keydown.enter.prevent="addItem()">
                  <wa-icon slot="start" name="plus"></wa-icon>
                </wa-input>
                <wa-button size="small" appearance="filled" data-testid="add-item"
                           :disabled="!newItemText.trim()" @click="addItem()">Add</wa-button>
              </div>

              <p class="slist__count" x-show="currentList.contentsForList.length"
                 x-text="openItemCount + (openItemCount === 1 ? ' item left' : ' items left')"></p>

              <ul class="slist__rows wa-stack wa-gap-3xs">
                <template x-for="item in sortedItems" :key="item.id">
                  <li class="sitem wa-cluster wa-gap-xs" :class="{ 'sitem--done': item.isCompleted && !item.isHeading,
                                              'sitem--heading': item.isHeading }">
                    <template x-if="!item.isHeading">
                      <wa-checkbox :checked="item.isCompleted"
                                   @change="item.isCompleted = $event.target.checked; touchList()"
                                   :aria-label="item.text"></wa-checkbox>
                    </template>

                    <wa-input class="sitem__text" size="small" appearance="filled"
                              x-model="item.text" @input="touchList()"
                              :aria-label="item.isHeading ? 'Section heading' : 'Item'"></wa-input>

                    <wa-button size="small" appearance="plain" x-show="!item.isHeading"
                               :title="item.isImportant ? 'Not important' : 'Mark important'"
                               @click="item.isImportant = !item.isImportant; touchList()">
                      <wa-icon :name="item.isImportant ? 'star' : 'star'"
                               :variant="item.isImportant ? 'solid' : 'regular'"
                               :label="item.isImportant ? 'Important' : 'Mark important'"></wa-icon>
                    </wa-button>

                    <wa-button size="small" appearance="plain" title="Remove"
                               @click="removeItem(item)">
                      <wa-icon name="xmark" label="Remove"></wa-icon>
                    </wa-button>
                  </li>
                </template>
              </ul>

              <p class="empty" x-show="!currentList.contentsForList.length">
                Nothing on this list yet.
              </p>
            </div>
          </template>
        </div>
      </template>
    </div>
  </section>

  </main>

  <!-- Nested inside nothing: a dialog opened from within the editor dialog would stack, so this
       is a sibling and the editor stays open behind it. -->
  <wa-dialog label="New tag" :open="newTagOpen" @wa-hide="if ($event.target === $el) { newTagOpen = false; newTagName = ''; }">
    <wa-input label="Tag name" with-label x-model="newTagName" autofocus
              @keydown.enter.prevent="createTagInline()"></wa-input>
    <wa-button slot="footer" appearance="plain" @click="newTagOpen = false; newTagName = ''">Cancel</wa-button>
    <wa-button slot="footer" appearance="accent" variant="brand" data-testid="create-tag"
               :disabled="!newTagName.trim()" @click="createTagInline()">Add</wa-button>
  </wa-dialog>

  <wa-dialog label="Delete list" :open="confirmDeleteList" @wa-hide="confirmDeleteList = false">
    <p>Delete <strong x-text="currentList ? (currentList.name || 'this list') : ''"></strong>? This
       cannot be undone.</p>
    <wa-button slot="footer" appearance="plain" @click="confirmDeleteList = false">Cancel</wa-button>
    <wa-button slot="footer" variant="danger" appearance="accent" @click="deleteList()">Delete</wa-button>
  </wa-dialog>

  <!-- Editing is modal, matching the Swift client, which presents its editor as a .sheet over the
       detail column rather than inside it. It also closes a real hazard: with the editor inline the
       rail and recipe list stayed live behind it, so picking another category swapped the middle
       column out from under the recipe being edited. Every other way out of an edit already had to
       remember to ask about unsaved work by hand; a dialog makes that structural instead.

       light-dismiss is left off (WA's default) so a stray click outside cannot discard an edit.
       Escape and the close button raise wa-hide, which is cancelable -- see onEditDialogHide. -->
  <wa-dialog class="editdlg" label="Edit recipe" :open="mode === 'edit'"
             @wa-hide="if ($event.target === $el) onEditDialogHide($event)">
    <!-- Built only while actually editing: a recipe merely being read shouldn't carry the whole
         editor -- every row, select and sortable -- around in the DOM behind a closed dialog. -->
    <template x-if="current && mode === 'edit'">
      <div class="edit">
        <wa-input class="titlefield" x-model="current.name" @input="touch()"
                  aria-label="Recipe name" size="large"></wa-input>

        <wa-card class="sect">
          <div slot="header" class="sect__head wa-split wa-align-items-center"><h3>Image</h3></div>
          <!-- Staged, not uploaded on the spot: see chooseImage. The file input is the real one,
               kept off-screen rather than display:none so it stays focusable, with the wa-button
               acting as its label. -->
          <div class="imgedit wa-stack wa-gap-s">
            <template x-if="imageUrl">
              <img class="imgedit__preview" :src="imageUrl" alt="Recipe image">
            </template>
            <template x-if="!imageUrl">
              <div class="imgedit__empty">
                <wa-icon name="image" class="imgedit__icon"></wa-icon>
                <span>No image</span>
              </div>
            </template>

            <div class="imgedit__actions wa-cluster wa-gap-xs">
              <input type="file" id="imgfile" class="wa-visually-hidden" aria-label="Recipe image file"
                     accept="image/jpeg,image/png,image/gif" @change="chooseImage($event)">
              <wa-button size="small" appearance="filled" data-testid="choose-image"
                         @click="document.getElementById('imgfile').click()">
                <wa-icon slot="start" name="arrow-up-from-bracket"></wa-icon>
                <span x-text="imageUrl ? 'Replace…' : 'Choose Image…'"></span>
              </wa-button>
              <wa-button size="small" appearance="plain" data-testid="clear-image"
                         x-show="imageUrl" @click="clearImage()">
                <wa-icon slot="start" name="xmark"></wa-icon> Remove
              </wa-button>
              <span class="imgedit__hint" x-show="pendingImageFile || pendingImageRemoval"
                    x-text="pendingImageFile ? 'New image — saves with the recipe' : 'Will be removed on save'"></span>
            </div>
            <p class="imgedit__note">JPEG, PNG or GIF, up to 25 MB.</p>
          </div>
        </wa-card>

        <wa-card class="sect">
          <div slot="header" class="sect__head wa-split wa-align-items-center"><h3>Details</h3></div>

          <!-- Grouped into lines that belong together rather than one auto-fitting grid, which
               reflowed fields into arbitrary neighbours at every width. Each .fieldrow still wraps
               on a narrow screen, so this is grouping, not a fixed column count. -->
          <div class="fieldrow wa-grid">
            <wa-input label="Source" with-label x-model="current.source" @input="touch()"></wa-input>
            <wa-input label="Source details" with-label x-model="current.sourceDetails"
                      @input="touch()"></wa-input>
          </div>

          <wa-textarea class="intro" label="Introduction" with-label resize="auto" rows="3"
                       x-model="current.introduction" @input="touch()"></wa-textarea>

          <div class="fieldrow wa-grid">
            <wa-input label="Yield" with-label x-model="current.yield" @input="touch()"></wa-input>
            <wa-input label="Servings" with-label type="number" step="1" min="0"
                      x-model.number="current.servings" @input="touch()"></wa-input>
            <wa-select label="Course" with-label x-model="current.courseId" @change="touch()">
              <wa-option value="">None</wa-option>
              <template x-for="c in courses" :key="c.id">
                <wa-option :value="c.id" x-text="c.name"></wa-option>
              </template>
            </wa-select>
          </div>

          <div class="fieldrow wa-grid">
            <wa-select label="Difficulty" with-label :value="String(current.difficulty ?? 0)"
                       @change="current.difficulty = Number($event.target.value); touch()">
              <wa-option value="0">(not set)</wa-option>
              <wa-option value="1">Easy</wa-option>
              <wa-option value="2">Somewhat Easy</wa-option>
              <wa-option value="3">Medium</wa-option>
              <wa-option value="4">Slightly Difficult</wa-option>
              <wa-option value="5">Difficult</wa-option>
            </wa-select>

            <div class="field">
              <label class="field__label">Rating</label>
              <!-- width:max-content in CSS: wa-rating is role=slider and maps click position
                   across its element width, so a stretched box makes the last star unhittable. -->
              <wa-rating class="rating-field" label="Rating" :value="current.rating || 0"
                         @change="current.rating = Number($event.target.value); touch()"></wa-rating>
            </div>
          </div>

          <!-- Both flags were settable everywhere except the editor, which is the one place you'd
               expect to set them while writing the recipe down. -->
          <div class="fieldrow fieldrow--flags wa-cluster wa-gap-m">
            <wa-checkbox :checked="!!current.isFavorite"
                         @change="current.isFavorite = $event.target.checked; touch()">
              Favorite
            </wa-checkbox>
            <wa-checkbox :checked="!!current.wantToMake"
                         @change="current.wantToMake = $event.target.checked; touch()">
              Want to Make
            </wa-checkbox>
          </div>

          <div class="fieldrow wa-grid">
            <wa-select multiple with-clear max-options-visible="4" label="Categories" with-label
                       x-model="current.categoryIds" @change="touch()">
              <template x-for="c in categories" :key="c.id">
                <wa-option :value="c.id" x-text="c.name"></wa-option>
              </template>
            </wa-select>

            <div class="field">
              <label class="field__label">Tags</label>
              <div class="tagfield wa-cluster wa-gap-2xs">
                <wa-select multiple with-clear max-options-visible="4" aria-label="Tags"
                           x-model="current.tagIds" @change="touch()">
                  <template x-for="t in tags" :key="t.id">
                    <wa-option :value="t.id" x-text="t.name"></wa-option>
                  </template>
                </wa-select>
                <!-- Tags get invented while writing a recipe far more often than courses or
                     categories do, so this makes one and attaches it without leaving the editor. -->
                <wa-button size="small" appearance="plain" title="New tag"
                           data-testid="new-tag" @click="newTagOpen = true">
                  <wa-icon name="plus" label="New tag"></wa-icon>
                </wa-button>
              </div>
            </div>
          </div>

          <div class="fieldrow fieldrow--narrow wa-grid">
            <div class="field">
              <label class="field__label" for="lastPrepared">Last Prepared</label>
              <input class="native-date" type="date" id="lastPrepared"
                     :value="dateOnly(current.lastPrepared)"
                     @change="setLastPrepared($event.target.value)">
            </div>
          </div>
        </wa-card>

        <wa-card class="sect">
          <div slot="header" class="sect__head wa-split wa-align-items-center">
            <h3>Ingredients</h3>
          </div>
          <ul class="rows rows--plain" x-sort="(item, pos) => reorder('ingredients', item, pos)"
              x-sort:config="{ handle: '.grip' }">
            <template x-for="(row, i) in ingredients" :key="row.id">
              <li class="row" :class="{ 'row--heading': row.isHeading, 'row--main': row.isMain }"
                  x-sort:item="row.id">
                <span class="grip" title="Drag to reorder" aria-hidden="true">
                  <wa-icon name="grip-vertical"></wa-icon>
                </span>
                <wa-textarea class="row__edit" x-model="row.text" @input="touch()"
                             resize="auto" rows="1"
                             :aria-label="(row.isHeading ? 'Heading ' : 'Ingredient ') + (i + 1)"></wa-textarea>
                <span class="row__tools">
                  <wa-button size="small" appearance="plain" :disabled="i === 0"
                             :data-move="'ingredients:' + row.id + ':up'"
                             @click="moveRow('ingredients', row.id, -1)" title="Move up">
                    <wa-icon name="chevron-up" label="Move up"></wa-icon>
                  </wa-button>
                  <wa-button size="small" appearance="plain" :disabled="i === ingredients.length - 1"
                             :data-move="'ingredients:' + row.id + ':down'"
                             @click="moveRow('ingredients', row.id, 1)" title="Move down">
                    <wa-icon name="chevron-down" label="Move down"></wa-icon>
                  </wa-button>
                  <wa-button size="small" appearance="plain" x-show="!row.isHeading"
                             @click="row.isMain = !row.isMain; touch()"
                             :title="row.isMain ? 'Main ingredient' : 'Mark as main ingredient'">
                    <wa-icon name="star" :variant="row.isMain ? 'solid' : 'regular'"
                             label="Mark as main ingredient"></wa-icon>
                  </wa-button>
                  <wa-button size="small" appearance="plain" @click="removeRow('ingredients', i)" title="Delete">
                    <wa-icon name="xmark" label="Delete row"></wa-icon>
                  </wa-button>
                </span>
              </li>
            </template>
          </ul>
          <div slot="footer" class="sect__foot wa-cluster wa-gap-xs">
            <wa-button size="small" appearance="filled" @click="addRow('ingredients', false)">
              <wa-icon slot="start" name="plus"></wa-icon> Ingredient
            </wa-button>
            <wa-button size="small" appearance="plain" @click="addRow('ingredients', true)">
              <wa-icon slot="start" name="heading"></wa-icon> Section heading
            </wa-button>
          </div>
        </wa-card>

        <wa-card class="sect">
          <div slot="header" class="sect__head wa-split wa-align-items-center">
            <h3>Directions</h3>
          </div>
          <ul class="rows" x-sort="(item, pos) => reorder('directions', item, pos)"
              x-sort:config="{ handle: '.grip' }">
            <template x-for="(row, i) in directions" :key="row.id">
              <li class="row" :class="{ 'row--heading': row.isHeading }" x-sort:item="row.id">
                <span class="grip" title="Drag to reorder" aria-hidden="true">
                  <wa-icon name="grip-vertical"></wa-icon>
                </span>
                <span class="row__lead" x-text="row.isHeading ? '' : stepNumber(i) + '.'"></span>
                <wa-textarea class="row__edit" x-model="row.text" @input="touch()"
                             resize="auto" rows="1"
                             :aria-label="(row.isHeading ? 'Heading ' : 'Step ') + (i + 1)"></wa-textarea>
                <span class="row__tools">
                  <wa-button size="small" appearance="plain" :disabled="i === 0"
                             :data-move="'directions:' + row.id + ':up'"
                             @click="moveRow('directions', row.id, -1)" title="Move up">
                    <wa-icon name="chevron-up" label="Move up"></wa-icon>
                  </wa-button>
                  <wa-button size="small" appearance="plain" :disabled="i === directions.length - 1"
                             :data-move="'directions:' + row.id + ':down'"
                             @click="moveRow('directions', row.id, 1)" title="Move down">
                    <wa-icon name="chevron-down" label="Move down"></wa-icon>
                  </wa-button>
                  <wa-button size="small" appearance="plain" @click="removeRow('directions', i)" title="Delete">
                    <wa-icon name="xmark" label="Delete row"></wa-icon>
                  </wa-button>
                </span>
              </li>
            </template>
          </ul>
          <div slot="footer" class="sect__foot wa-cluster wa-gap-xs">
            <wa-button size="small" appearance="filled" @click="addRow('directions', false)">
              <wa-icon slot="start" name="plus"></wa-icon> Step
            </wa-button>
            <wa-button size="small" appearance="plain" @click="addRow('directions', true)">
              <wa-icon slot="start" name="heading"></wa-icon> Section heading
            </wa-button>
          </div>
        </wa-card>

        <!-- Secondary editors. Collapsed by default and set apart from the cards above because most
             recipes have none of this, and seventeen nutrition fields left open would bury the
             ingredients. The summary carries a count, so what IS filled in is visible without
             opening anything. -->
        <wa-details class="subsect" data-testid="details-times"
                    :summary="'Preparation Times' + (current.preparationTimes.length ? ' (' + current.preparationTimes.length + ')' : '')">
          <template x-for="row in current.preparationTimes" :key="row.id">
            <div class="subrow wa-cluster wa-gap-xs">
              <wa-input size="small" placeholder='Type (e.g., "Bake")' aria-label="Time type"
                        x-model="row.type" @input="touch()"></wa-input>
              <wa-input size="small" placeholder='Time (e.g., "1 hr, 30 min")' aria-label="Time"
                        x-model="row.timeString" @input="touch()"></wa-input>
              <wa-button size="small" appearance="plain" title="Remove"
                         @click="removeSubRow('preparationTimes', row.id)">
                <wa-icon name="xmark" label="Remove"></wa-icon>
              </wa-button>
            </div>
          </template>
          <wa-button size="small" appearance="filled" data-testid="add-time"
                     @click="addSubRow('preparationTimes', { type: '', timeString: '' })">
            <wa-icon slot="start" name="plus"></wa-icon> Time
          </wa-button>
        </wa-details>

        <wa-details class="subsect" data-testid="details-notes"
                    :summary="'Notes' + (current.notes.length ? ' (' + current.notes.length + ')' : '')">
          <template x-for="row in current.notes" :key="row.id">
            <div class="subblock">
              <div class="subblock__head wa-cluster wa-gap-xs">
                <wa-input size="small" placeholder="Note Title" aria-label="Note title"
                          x-model="row.title" @input="touch()"></wa-input>
                <wa-button size="small" appearance="plain" title="Remove"
                           @click="removeSubRow('notes', row.id)">
                  <wa-icon name="xmark" label="Remove"></wa-icon>
                </wa-button>
              </div>
              <wa-textarea size="small" resize="auto" rows="2" placeholder="Note content"
                           aria-label="Note content" x-model="row.content" @input="touch()"></wa-textarea>
            </div>
          </template>
          <wa-button size="small" appearance="filled" data-testid="add-note"
                     @click="addSubRow('notes', { title: '', content: '' })">
            <wa-icon slot="start" name="plus"></wa-icon> Note
          </wa-button>
        </wa-details>

        <wa-details class="subsect" data-testid="details-variations"
                    :summary="'Variations' + (current.variations.length ? ' (' + current.variations.length + ')' : '')">
          <template x-for="row in current.variations" :key="row.id">
            <div class="subblock">
              <div class="subblock__head wa-cluster wa-gap-xs">
                <wa-input size="small" placeholder="Variation Name" aria-label="Variation name"
                          x-model="row.variationName" @input="touch()"></wa-input>
                <wa-button size="small" appearance="plain" title="Remove"
                           @click="removeSubRow('variations', row.id)">
                  <wa-icon name="xmark" label="Remove"></wa-icon>
                </wa-button>
              </div>
              <wa-textarea size="small" resize="auto" rows="2" placeholder="Text"
                           aria-label="Variation text" x-model="row.text" @input="touch()"></wa-textarea>
            </div>
          </template>
          <wa-button size="small" appearance="filled" data-testid="add-variation"
                     @click="addSubRow('variations', { variationName: '', text: '' })">
            <wa-icon slot="start" name="plus"></wa-icon> Variation
          </wa-button>
        </wa-details>

        <!-- Fields come from NUTRITION_GROUPS in editor.js, which the reading view reads too, so
             the two can't drift and a new field only has to be named once. -->
        <wa-details class="subsect" data-testid="details-nutrition"
                    :summary="'Nutrition' + (nutritionRows.length ? ' (' + nutritionRows.length + ')' : '')">
          <template x-for="g in nutritionGroups" :key="g.group">
            <div class="nutgroup">
              <h4 class="nutgroup__head" x-text="g.group"></h4>
              <div class="nutgrid wa-grid">
                <template x-for="f in g.fields" :key="f.key">
                  <wa-input size="small" with-label
                            :label="f.label + (f.unit ? ' (' + f.unit + ')' : '')"
                            :type="f.text ? 'text' : 'number'"
                            :placeholder="f.placeholder || ''"
                            :value="nutritionValue(f.key)"
                            @input="setNutrition(f.key, $event.target.value, !!f.text)"></wa-input>
                </template>
              </div>
            </div>
          </template>
        </wa-details>

      </div>
    </template>

    <!-- Cancel and Save, the pairing people expect from a modal. It replaces Revert/Save/Done,
         which offered three exits for two intentions: Revert discarded AND closed (so it was
         Cancel by another name), while Save and Done differed only in whether the dialog stayed
         open -- a distinction nobody asked for. -->
    <div slot="footer" class="savebar savebar--dialog wa-cluster wa-gap-xs">
      <span class="savebar__status" :class="{ 'is-dirty': dirty }"
            x-text="dirty ? 'Unsaved changes' : 'All changes saved'"></span>
      <wa-button data-testid="cancel" size="small" appearance="plain"
                 @click="cancelEdit()">Cancel</wa-button>
      <wa-button data-testid="save" size="small" appearance="accent" variant="brand"
                 :loading="saving" @click="saveAndClose()">Save</wa-button>
    </div>
  </wa-dialog>

  <!-- Library manager: rename, add and remove courses, categories and tags. Deliberately plain --
       merging duplicates and reassigning recipes are deeper operations that belong with the
       existing LibraryDuplicateMerger work, not here. -->
  <wa-dialog label="Manage library" class="managedlg" :open="libraryManagerOpen"
             @wa-hide="libraryManagerOpen = false">
    <wa-tab-group>
      <template x-for="group in libraryGroups" :key="group.kind">
        <wa-tab :panel="group.kind" slot="nav" x-text="group.label"></wa-tab>
      </template>

      <template x-for="group in libraryGroups" :key="group.kind">
        <wa-tab-panel :name="group.kind">
          <div class="mgr">
            <template x-for="item in group.items" :key="item.id">
              <div class="mgr__row">
                <wa-input size="small" :value="item.name"
                          @change="renameClassifier(group.kind, item, $event.target.value)"
                          :aria-label="'Name of ' + (item.name || 'untitled')"></wa-input>
                <span class="mgr__count" x-text="recipeCountLabel(group.kind, item.id)"></span>
                <wa-button size="small" appearance="plain" variant="danger"
                           @click="askDeleteClassifier(group.kind, item)"
                           :title="'Delete ' + item.name">
                  <wa-icon name="trash" :label="'Delete ' + item.name"></wa-icon>
                </wa-button>
              </div>
            </template>

            <p class="mgr__empty" x-show="!group.items.length">Nothing here yet.</p>

            <form class="mgr__add" @submit.prevent="addClassifier(group.kind)">
              <wa-input size="small" :placeholder="'New ' + group.singular"
                        x-model="newClassifier[group.kind]"
                        :aria-label="'New ' + group.label"></wa-input>
              <wa-button size="small" appearance="filled" type="submit"
                         :disabled="!(newClassifier[group.kind] || '').trim()">Add</wa-button>
            </form>
          </div>
        </wa-tab-panel>
      </template>
    </wa-tab-group>

    <wa-button slot="footer" appearance="plain" @click="libraryManagerOpen = false">Done</wa-button>
  </wa-dialog>

  <wa-dialog label="Delete from library" :open="!!pendingClassifierDelete"
             @wa-hide="pendingClassifierDelete = null">
    <p x-show="pendingClassifierDelete">
      Delete “<strong x-text="pendingClassifierDelete?.item?.name"></strong>”?
      <template x-if="pendingClassifierDelete && countFor(pendingClassifierDelete.kind, pendingClassifierDelete.item.id) > 0">
        <span>It will be removed from
          <strong x-text="countFor(pendingClassifierDelete.kind, pendingClassifierDelete.item.id)"></strong>
          recipe(s). The recipes themselves are kept.</span>
      </template>
    </p>
    <wa-button slot="footer" appearance="plain" @click="pendingClassifierDelete = null">Cancel</wa-button>
    <wa-button slot="footer" variant="danger" appearance="accent"
               @click="deleteClassifier()">Delete</wa-button>
  </wa-dialog>

  <wa-dialog label="Delete recipe" :open="confirmDelete" @wa-hide="confirmDelete = false">
    <p>Delete “<strong x-text="current ? current.name : ''"></strong>”? This removes it from every
       synced device and can't be undone.</p>
    <wa-button slot="footer" appearance="plain" @click="confirmDelete = false">Cancel</wa-button>
    <wa-button slot="footer" variant="danger" appearance="accent" @click="doDelete()">Delete</wa-button>
  </wa-dialog>

  <div class="toasts" aria-live="polite">
    <template x-for="t in toasts" :key="t.id">
      <wa-callout :variant="t.variant" class="toast">
        <wa-icon slot="icon" :name="t.variant === 'danger' ? 'circle-exclamation' : 'circle-check'"></wa-icon>
        <span x-text="t.text"></span>
      </wa-callout>
    </template>
  </div>
</wa-page>

</body>
</html>
