import com.enuvro.saltykmp.db.model.Difficulty;
import com.enuvro.saltykmp.db.model.Direction;
import com.enuvro.saltykmp.db.model.Ingredient;
import com.enuvro.saltykmp.db.model.Note;
import com.enuvro.saltykmp.db.model.NutritionInformation;
import com.enuvro.saltykmp.db.model.PreparationTime;
import com.enuvro.saltykmp.db.model.Rating;
import com.enuvro.saltykmp.db.model.ShoppingListListContents;
import com.enuvro.saltykmp.db.model.Variation;
import kotlin.Boolean;
import kotlin.collections.List;

CREATE TABLE "course" (
    "id" TEXT PRIMARY KEY ON CONFLICT REPLACE NOT NULL,
    "name" TEXT,
    "lastModifiedDate" TEXT,
    -- The lastModifiedDate this row carried when this library and the server last agreed about it
    -- (SHARED-V0006) — the recipe.syncedModifiedDate mechanism, extended to the library tables so a
    -- row that exists here and not on the server is classified by a recorded fact instead of a clock
    -- guess. TEXT because SQLDelight's grammar rejects DATETIME; the ledgered ALTER in Database.kt
    -- says DATETIME, matching Salty and Salty.NET (declared type is out of contract, values identical).
    "syncedModifiedDate" TEXT
);

CREATE TABLE "category" (
    "id" TEXT PRIMARY KEY ON CONFLICT REPLACE NOT NULL,
    "name" TEXT,
    "lastModifiedDate" TEXT,
    -- SHARED-V0006 agreement stamp; see course.
    "syncedModifiedDate" TEXT
);

-- NOT NULL DEFAULTs mirror the Swift app's non-optional Recipe columns (Salty/Models/Schema.swift): the
-- Salty app decodes these straight into non-optional Swift properties (Date, String, Bool, and the JSON
-- List<…>/enum columns), so a NULL here makes the row un-decodable on that side. The KMP write path
-- (LocalStore.upsertRecipe) already coalesces each of these to a concrete value; these constraints make
-- the shared DB enforce that invariant for any writer (raw SQL, future code) and for fresh KMP-created
-- files. Genuinely-optional columns (lastPrepared, image*, servings, courseId, nutrition,
-- lastModifiedImageDate, lastModifiedPreparedDate) stay nullable to match the Swift optionals.
-- CURRENT_TIMESTAMP yields
-- "YYYY-MM-DD HH:MM:SS", which GRDB decodes as a Date.
CREATE TABLE "recipe" (
    "id" TEXT PRIMARY KEY ON CONFLICT REPLACE NOT NULL,
    "name" TEXT NOT NULL DEFAULT '',
    "createdDate" TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    "lastModifiedDate" TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    "lastPrepared" TEXT,
    "source" TEXT NOT NULL DEFAULT '',
    "sourceDetails" TEXT NOT NULL DEFAULT '',
    "introduction" TEXT NOT NULL DEFAULT '',
    "difficulty" INTEGER AS Difficulty NOT NULL DEFAULT 0,
    "rating" INTEGER AS Rating NOT NULL DEFAULT 0,
    "imageFilename" TEXT,
    "imageThumbnailData" BLOB,
    "isFavorite" INTEGER AS Boolean NOT NULL DEFAULT 0,
    "wantToMake" INTEGER AS Boolean NOT NULL DEFAULT 0,
    "yield" TEXT NOT NULL DEFAULT '',
    "servings" INTEGER,
    "courseId" TEXT REFERENCES "course"("id") ON DELETE SET NULL,
    "directions" TEXT AS List<Direction> NOT NULL DEFAULT '[]',
    "ingredients" TEXT AS List<Ingredient> NOT NULL DEFAULT '[]',
    "notes" TEXT AS List<Note> NOT NULL DEFAULT '[]',
    "variations" TEXT AS List<Variation> NOT NULL DEFAULT '[]',
    "preparationTimes" TEXT AS List<PreparationTime> NOT NULL DEFAULT '[]',
    "nutrition" TEXT AS NutritionInformation,
    -- Bumped only on image change, independent of lastModifiedDate. Appended at the end so the Swift
    -- app's SELECT * keeps working. Added to existing DBs via the shared migration ledger (Database.kt).
    "lastModifiedImageDate" TEXT,
    -- Bumped only when `lastPrepared` changes ("marked as prepared"), independent of lastModifiedDate. Same
    -- decoupling trick as lastModifiedImageDate, for the opposite reason: images are too EXPENSIVE to
    -- re-transfer on a body edit, whereas marking a recipe prepared must NOT look like a body edit — bumping
    -- lastModifiedDate would shove the recipe to the top of the "Date Modified" sort every time you cook
    -- it. So the body clock stays untouched and sync reconciles this field on its own (SyncService's
    -- prepared-date pass, mirroring the image pass). NULL = lastPrepared has never been set through a
    -- prepared-date-aware client. Appended at the end for the other platform's SELECT *; added to
    -- existing DBs by SHARED-V0004 (Database.kt).
    "lastModifiedPreparedDate" TEXT,
    -- The value of `lastModifiedDate` this row carried the last time this library and the server agreed
    -- about it. NULL = they never have, and that distinction is the whole point: it lets sync tell a
    -- recipe that is NEW HERE apart from one the server has DELETED, without comparing any clock. The
    -- old rule compared the row's timestamp to the sync watermark, which is wrong whenever the device
    -- and server clocks disagree, and wrong for any row whose timestamp is genuinely old but has never
    -- been anywhere — a recipe imported from a years-old export read as "deleted on the server" and was
    -- destroyed. Appended at the end for the other platforms' SELECT *; added to existing DBs by
    -- SHARED-V0005 (Database.kt). Mirror: Salty's `syncedModifiedDate`, Salty.NET's same column.
    "syncedModifiedDate" TEXT
 );

CREATE TABLE "recipeCategory" (
    "id" TEXT PRIMARY KEY ON CONFLICT REPLACE NOT NULL,
    "recipeId" TEXT NOT NULL REFERENCES recipe(id) ON DELETE CASCADE,
    "categoryId" TEXT NOT NULL REFERENCES category(id) ON DELETE CASCADE
  );

-- Index names match what GRDB's `.indexed()` generates ("<table>_on_<column>") in the Swift app's
-- migration 0001, so a KMP-created and a Swift-created DB converge on the same schema. Existing KMP
-- DBs (created before these were added) get them from ensureJunctionIndexes (Database.kt), which is
-- also why re-creating here is safe: CREATE INDEX only runs on fresh files. recipe.courseId is
-- deliberately NOT indexed — the Swift app doesn't index it either, and parity wins.
CREATE INDEX recipeCategory_on_recipeId ON recipeCategory(recipeId);
CREATE INDEX recipeCategory_on_categoryId ON recipeCategory(categoryId);

CREATE TABLE "tag" (
    "id" TEXT PRIMARY KEY ON CONFLICT REPLACE NOT NULL,
    "name" TEXT,
    "lastModifiedDate" TEXT,
    -- SHARED-V0006 agreement stamp; see course.
    "syncedModifiedDate" TEXT
 );

CREATE TABLE "recipeTag" (
    "id" TEXT PRIMARY KEY ON CONFLICT REPLACE NOT NULL,
    "recipeId" TEXT NOT NULL REFERENCES recipe(id) ON DELETE CASCADE,
    "tagId" TEXT NOT NULL REFERENCES tag(id) ON DELETE CASCADE
);

-- See the recipeCategory indexes above for naming and the existing-DB retrofit.
CREATE INDEX recipeTag_on_recipeId ON recipeTag(recipeId);
CREATE INDEX recipeTag_on_tagId ON recipeTag(tagId);

-- Column order matches what the Swift app's shared-migration ALTERs produce on a DB that predates
-- them (the other platform's SELECT * reads positionally): lastModifiedDate from SHARED-V0002, then
-- the two sync-state columns from SHARED-V0003.
--
-- syncedRevision/syncedSnapshot are per-row sync bookkeeping, never edited by UI code: the server
-- revision this row was last agreed at, and the wire-JSON ServerShoppingList of that agreement.
-- "Locally dirty" = row differs from snapshot; "server changed" = server revision != syncedRevision.
-- The snapshot is also the BASE for three-way merges. NULL in both = never synced under revisions
-- (legacy row) — the first revision-aware sync seeds them. Snapshot stays plain TEXT (no column
-- adapter): the sync layer owns the encoding via apiJson.
CREATE TABLE "shoppingList" (
    "id" TEXT PRIMARY KEY ON CONFLICT REPLACE NOT NULL,
    "name" TEXT,
    "isFreeform" INTEGER AS Boolean,
    "contentsForList" TEXT AS List<ShoppingListListContents>,
    "contentsForFreeform" TEXT,
    "lastModifiedDate" TEXT,
    "syncedRevision" INTEGER,
    "syncedSnapshot" TEXT
 );

-- Tombstones for recipes deleted locally. Sync sends these to the server's /sync/delete and excludes
-- them from the manifest so a deleted recipe is never re-downloaded. See migration 1.sqm.
CREATE TABLE "deletedRecipe" (
    "id" TEXT NOT NULL PRIMARY KEY,
    "deletedDate" TEXT NOT NULL
);
