composeApp/salty.db

# Machine-specific + build/deploy artifacts (should not be committed)
# The compose files hold the deploy's real secrets inline; only the CHANGE_ME_* templates
# (docker-compose*.example.yml) are committed.
/docker-compose.yml
/docker-compose.offline.yml
local.properties
/.kotlin
/composeApp/release
# Saved Docker images for the offline deploy (saltyserver-image.tar, postgres18-image.tar).
# Unanchored: they get written wherever `docker save` is run, not just under server/.
*-image.tar
/salty-images

# Android release signing — the properties file holds the keystore password, and keys never belong in git.
keystore.properties
*.jks
*.keystore

# H2 development databases and image stores. Unanchored on purpose: the server writes these
# relative to its working directory, which is server/ under `gradlew :server:run` but the repo
# root elsewhere. The previous rules had a leading or embedded slash, so git anchored them to the
# root and a live database with the admin row was committed for five commits.
salty-db/
salty-images*/
*.mv.db
*.lock.db
*.trace.db
